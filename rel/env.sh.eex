#!/bin/sh

# Parse command line arguments for configuration path
# Supports: --config /path/to/config.toml or --config=/path/to/config.toml
# Also supports: GSMLG_CONFIG_PATH environment variable
for arg in "$@"; do
  case $arg in
    --config=*)
      export GSMLG_CONFIG_PATH="${arg#*=}"
      shift
      ;;
    --config)
      export GSMLG_CONFIG_PATH="$2"
      shift
      shift
      ;;
    *)
      ;;
  esac
done

if [ -z "${GSMLG_CONFIG_PATH:-}" ] && [ "<%= @release.name %>" = "gsmlg_commander" ] && [ -n "${HOME:-}" ]; then
  export GSMLG_CONFIG_PATH="$HOME/.config/gsmlg/commander/config.toml"
fi

if [ "<%= @release.name %>" = "gsmlg_commander" ] && [ -n "${GSMLG_CONFIG_PATH:-}" ] && [ ! -e "$GSMLG_CONFIG_PATH" ]; then
  mkdir -p "$(dirname "$GSMLG_CONFIG_PATH")"
  cat >"$GSMLG_CONFIG_PATH" <<'EOF'
[commander]
start = true
server = false
name = "commander"
umbrella_server_url = "http://localhost:4111"
platform_key = "CHANGE_ME"
features = ["pty"]
EOF
  chmod 600 "$GSMLG_CONFIG_PATH" 2>/dev/null || true
fi

# Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# Set the release to work across nodes. If using the long name format like
# the one below (my_app@127.0.0.1), you need to also uncomment the
# RELEASE_DISTRIBUTION variable below. Must be "sname", "name" or "none".
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=<%= @release.name %>@${HOSTNAME}
