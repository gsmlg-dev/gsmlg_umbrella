<Layouts.app flash={@flash} page_title={@page_title}>
  <div class="relative">
    <GSMLG.AdminWeb.PKILive.Components.PkiLeftMenu.pki_left_menu active_menu={@active_menu} />
  </div>
  <div class="flex flex-col flex-auto mx-auto max-w-screen-2xl px-4 py-8">
    <%= if @ca do %>
      <div class="flex justify-between items-center mb-6">
        <div>
          <.link navigate={~p"/pki/ca"} class="btn btn-sm btn-ghost mb-2">
            ← Back to CAs
          </.link>
          <h1 class="text-3xl font-bold">{@ca.subject}</h1>
          <p class="text-sm text-gray-500">CA ID: {@ca_id}</p>
        </div>
        <div class="flex gap-2">
          <.link navigate={~p"/pki/certificates/issue?ca_id=#{@ca_id}"} class="btn btn-primary">
            Issue Certificate
          </.link>
          <button phx-click="generate_crl" class="btn btn-secondary">Generate CRL</button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-lg">CA Information</h2>
            <div class="space-y-2 text-sm">
              <div>
                <span class="font-semibold">Key Type:</span>
                <span class="ml-2">{@ca.key_type}</span>
              </div>
              <div>
                <span class="font-semibold">Valid From:</span>
                <span class="ml-2">
                  {Calendar.strftime(@ca.not_before, "%Y-%m-%d %H:%M UTC")}
                </span>
              </div>
              <div>
                <span class="font-semibold">Valid Until:</span>
                <span class="ml-2">{Calendar.strftime(@ca.not_after, "%Y-%m-%d %H:%M UTC")}</span>
              </div>
              <div>
                <span class="font-semibold">Private Key:</span>
                <%= if @ca.private_key do %>
                  <span class="ml-2 badge badge-success">Available</span>
                <% else %>
                  <span class="ml-2 badge badge-error">Not Available</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <%= if @stats do %>
          <div class="card bg-base-100 shadow-xl col-span-2">
            <div class="card-body">
              <h2 class="card-title text-lg">Certificate Statistics</h2>
              <div class="stats stats-horizontal shadow w-full">
                <div class="stat">
                  <div class="stat-title">Active</div>
                  <div class="stat-value text-success">{@stats.active_certificates}</div>
                  <div class="stat-desc">Valid certificates</div>
                </div>
                <div class="stat">
                  <div class="stat-title">Revoked</div>
                  <div class="stat-value text-error">{@stats.revoked_certificates}</div>
                  <div class="stat-desc">Revoked certificates</div>
                </div>
                <div class="stat">
                  <div class="stat-title">Expired</div>
                  <div class="stat-value text-warning">{@stats.expired_certificates}</div>
                  <div class="stat-desc">Expired certificates</div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
          <h2 class="card-title">Recent Certificates</h2>
          <%= if Enum.empty?(@certificates) do %>
            <p class="text-gray-500">No certificates issued yet.</p>
          <% else %>
            <div class="overflow-x-auto">
              <table class="table table-zebra">
                <thead>
                  <tr>
                    <th>Serial</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Issued</th>
                    <th>Expires</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for cert <- @certificates do %>
                    <tr>
                      <td class="font-mono text-xs">{cert.serial}</td>
                      <td>{cert.subject}</td>
                      <td>
                        <span class={[
                          "badge",
                          cert.status == :active && "badge-success",
                          cert.status == :revoked && "badge-error",
                          cert.status == :expired && "badge-warning"
                        ]}>
                          {cert.status}
                        </span>
                      </td>
                      <td class="text-sm">{Calendar.strftime(cert.not_before, "%Y-%m-%d")}</td>
                      <td class="text-sm">{Calendar.strftime(cert.not_after, "%Y-%m-%d")}</td>
                      <td>
                        <.link
                          navigate={~p"/pki/certificates/#{cert.serial}"}
                          class="btn btn-xs btn-ghost"
                        >
                          View
                        </.link>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="card-actions justify-end mt-4">
              <.link
                navigate={~p"/pki/certificates?ca_id=#{@ca_id}"}
                class="btn btn-sm btn-primary"
              >
                View All Certificates
              </.link>
            </div>
          <% end %>
        </div>
      </div>

      <%= if @live_action == :stats && assigns[:expiring_certificates] do %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Expiring Certificates (Next 90 Days)</h2>
            <%= if Enum.empty?(@expiring_certificates) do %>
              <p class="text-success">No certificates expiring in the next 90 days.</p>
            <% else %>
              <div class="overflow-x-auto">
                <table class="table table-zebra">
                  <thead>
                    <tr>
                      <th>Serial</th>
                      <th>Subject</th>
                      <th>Expires</th>
                      <th>Days Remaining</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for cert <- @expiring_certificates do %>
                      <tr>
                        <td class="font-mono text-xs">{cert.serial}</td>
                        <td>{cert.subject}</td>
                        <td class="text-sm">{Calendar.strftime(cert.not_after, "%Y-%m-%d")}</td>
                        <td>
                          <span class={[
                            "badge",
                            cert.days_until_expiry <= 7 && "badge-error",
                            (cert.days_until_expiry > 7 and cert.days_until_expiry <= 30) &&
                              "badge-warning",
                            cert.days_until_expiry > 30 && "badge-info"
                          ]}>
                            {cert.days_until_expiry} days
                          </span>
                        </td>
                        <td>
                          <.link
                            navigate={~p"/pki/certificates/#{cert.serial}"}
                            class="btn btn-xs btn-ghost"
                          >
                            View
                          </.link>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="alert alert-error">
        <span>CA not found or failed to load.</span>
      </div>
    <% end %>
  </div>
</Layouts.app>
