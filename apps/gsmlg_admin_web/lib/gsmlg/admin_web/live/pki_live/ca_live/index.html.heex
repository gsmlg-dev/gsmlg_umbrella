<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex flex-col flex-auto mx-auto max-w-screen-2xl px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Certificate Authorities</h1>
      <.link navigate={~p"/pki/ca/new"} class="btn btn-primary">
        Initialize New CA
      </.link>
    </div>

    <%= if @live_action == :new do %>
      <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
          <h2 class="card-title">Initialize New Certificate Authority</h2>
          <.form
            for={@form}
            phx-submit="create_ca"
            phx-change="validate_form"
            class="space-y-6"
          >
            <!-- Subject Information -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold">Subject Information</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Common Name (CN) *</span>
                    <div
                      class="tooltip tooltip-left"
                      data-tip="The primary name for this CA. Appears in certificate chains and trust stores."
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        class="w-4 h-4 stroke-info shrink-0"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        >
                        </path>
                      </svg>
                    </div>
                  </label>
                  <input
                    type="text"
                    name="common_name"
                    value={Phoenix.HTML.Form.normalize_value("text", @form[:common_name].value)}
                    class={[
                      "input input-bordered",
                      @form[:common_name].errors != [] && "input-error"
                    ]}
                    placeholder="Example Root CA"
                    required
                  />
                  <%= if @form[:common_name].errors != [] do %>
                    <label class="label">
                      <span class="label-text-alt text-error">
                        {Enum.map(@form[:common_name].errors, fn {msg, _} -> msg end)
                        |> Enum.join(", ")}
                      </span>
                    </label>
                  <% end %>
                </div>

                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Organization (O)</span>
                  </label>
                  <input
                    type="text"
                    name="organization"
                    value={Phoenix.HTML.Form.normalize_value("text", @form[:organization].value)}
                    class="input input-bordered"
                    placeholder="Example Corp"
                  />
                </div>

                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Organizational Unit (OU)</span>
                  </label>
                  <input
                    type="text"
                    name="organizational_unit"
                    value={
                      Phoenix.HTML.Form.normalize_value("text", @form[:organizational_unit].value)
                    }
                    class="input input-bordered"
                    placeholder="IT Department"
                  />
                </div>

                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Country (C)</span>
                  </label>
                  <input
                    type="text"
                    name="country"
                    value={Phoenix.HTML.Form.normalize_value("text", @form[:country].value)}
                    class={[
                      "input input-bordered",
                      @form[:country].errors != [] && "input-error"
                    ]}
                    placeholder="US"
                    maxlength="2"
                  />
                  <%= if @form[:country].errors != [] do %>
                    <label class="label">
                      <span class="label-text-alt text-error">
                        {Enum.map(@form[:country].errors, fn {msg, _} -> msg end)
                        |> Enum.join(", ")}
                      </span>
                    </label>
                  <% end %>
                </div>

                <div class="form-control">
                  <label class="label">
                    <span class="label-text">State/Province (ST)</span>
                  </label>
                  <input
                    type="text"
                    name="state"
                    value={Phoenix.HTML.Form.normalize_value("text", @form[:state].value)}
                    class="input input-bordered"
                    placeholder="California"
                  />
                </div>

                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Locality (L)</span>
                  </label>
                  <input
                    type="text"
                    name="locality"
                    value={Phoenix.HTML.Form.normalize_value("text", @form[:locality].value)}
                    class="input input-bordered"
                    placeholder="San Francisco"
                  />
                </div>
              </div>
            </div>

            <!-- Key Configuration -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold">Key Configuration</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Key Type *</span>
                    <div
                      class="tooltip tooltip-left"
                      data-tip="RSA: Traditional, widely supported. ECDSA: Modern, smaller keys. Ed25519: Fastest, most secure."
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        class="w-4 h-4 stroke-info shrink-0"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        >
                        </path>
                      </svg>
                    </div>
                  </label>
                  <select
                    name="key_type"
                    class="select select-bordered"
                    phx-change="key_type_changed"
                  >
                    <option value="rsa" selected={@key_type == "rsa"}>RSA</option>
                    <option value="ecdsa" selected={@key_type == "ecdsa"}>ECDSA</option>
                    <option value="ed25519" selected={@key_type == "ed25519"}>Ed25519</option>
                  </select>
                </div>

                <%= if @key_type != "ed25519" do %>
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Key Size (bits) *</span>
                    </label>
                    <select name="key_size" class="select select-bordered">
                      <%= for size <- @available_key_sizes do %>
                        <option
                          value={size}
                          selected={@form[:key_size].value == size}
                        >
                          {size}
                        </option>
                      <% end %>
                    </select>
                  </div>
                <% else %>
                  <input type="hidden" name="key_size" value="256" />
                  <div class="alert alert-info">
                    <span class="text-sm">Ed25519 uses fixed 256-bit key size</span>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Validity Period -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold inline-flex items-center gap-2">
                Validity Period
                <div
                  class="tooltip"
                  data-tip="CA certificate will be valid from start date to end date. Default is 10 years. Industry best practice: max 20 years."
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    class="w-4 h-4 stroke-info shrink-0"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    >
                    </path>
                  </svg>
                </div>
              </h3>
              <GSMLG.AdminWeb.PKILive.Components.DateTimeRangePicker.datetime_range_picker
                id="validity"
                start_field={@form[:validity_start]}
                end_field={@form[:validity_end]}
              />
            </div>

            <!-- Private Key Encryption -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold">Private Key Security</h3>
              <div class="form-control">
                <label class="cursor-pointer label justify-start gap-2">
                  <input
                    type="checkbox"
                    name="encrypt_key"
                    value="true"
                    checked={@form[:encrypt_key].value}
                    class="checkbox checkbox-primary"
                  />
                  <span class="label-text">Encrypt private key with password</span>
                </label>
              </div>

              <%= if @form[:encrypt_key].value do %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Password *</span>
                    </label>
                    <input
                      type="password"
                      name="password"
                      class={[
                        "input input-bordered",
                        @form[:password].errors != [] && "input-error"
                      ]}
                      required
                    />
                    <%= if @form[:password].errors != [] do %>
                      <label class="label">
                        <span class="label-text-alt text-error">
                          {Enum.map(@form[:password].errors, fn {msg, _} -> msg end)
                          |> Enum.join(", ")}
                        </span>
                      </label>
                    <% end %>
                  </div>

                  <div class="form-control">
                    <label class="label">
                      <span class="label-text">Confirm Password *</span>
                    </label>
                    <input
                      type="password"
                      name="password_confirmation"
                      class={[
                        "input input-bordered",
                        @form[:password_confirmation].errors != [] && "input-error"
                      ]}
                      required
                    />
                    <%= if @form[:password_confirmation].errors != [] do %>
                      <label class="label">
                        <span class="label-text-alt text-error">
                          {Enum.map(@form[:password_confirmation].errors, fn {msg, _} -> msg end)
                          |> Enum.join(", ")}
                        </span>
                      </label>
                    <% end %>
                  </div>
                </div>

                <div class="alert alert-warning">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="stroke-current shrink-0 h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    />
                  </svg>
                  <span class="text-sm">
                    Password must be at least 12 characters with uppercase, lowercase, and digits. It will NOT be stored - you must remember it!
                  </span>
                </div>
              <% end %>
            </div>

            <div class="divider"></div>

            <div class="alert alert-warning">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-current shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <span>
                Initializing a CA will generate a new private key. Ensure you have secure backup procedures in place!
              </span>
            </div>

            <div class="card-actions justify-end">
              <.link navigate={~p"/pki/ca"} class="btn btn-ghost">Cancel</.link>
              <button
                type="submit"
                class="btn btn-primary"
                phx-disable-with="Generating Keys..."
              >
                <span
                  class="loading loading-spinner loading-sm"
                  style="display: none;"
                  data-phx-submit-loading
                ></span>
                <span data-phx-submit-not-loading>Initialize CA</span>
              </button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <%= if Enum.empty?(@cas) do %>
      <div class="alert alert-info">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="stroke-current shrink-0 w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>No Certificate Authorities found. Initialize your first CA to get started.</span>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= for ca <- @cas do %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">
                {ca.subject}
                <%= if ca.has_private_key do %>
                  <div class="badge badge-success">Key Available</div>
                <% else %>
                  <div class="badge badge-error">No Key</div>
                <% end %>
              </h2>

              <div class="text-sm space-y-2">
                <div>
                  <span class="font-semibold">Key Type:</span>
                  <span class="ml-2">{ca.key_type} {ca.key_size}</span>
                </div>
                <div>
                  <span class="font-semibold">Serial:</span>
                  <span class="ml-2 font-mono text-xs">{ca.serial}</span>
                </div>
                <div>
                  <span class="font-semibold">Valid Until:</span>
                  <span class="ml-2">{Calendar.strftime(ca.not_after, "%Y-%m-%d")}</span>
                </div>
              </div>

              <div class="divider my-2"></div>

              <div class="stats stats-vertical shadow">
                <div class="stat py-2">
                  <div class="stat-title text-xs">Active Certificates</div>
                  <div class="stat-value text-2xl text-success">
                    {ca.stats.active_certificates}
                  </div>
                </div>
                <div class="stat py-2">
                  <div class="stat-title text-xs">Revoked</div>
                  <div class="stat-value text-2xl text-error">
                    {ca.stats.revoked_certificates}
                  </div>
                </div>
                <div class="stat py-2">
                  <div class="stat-title text-xs">Expired</div>
                  <div class="stat-value text-2xl text-warning">
                    {ca.stats.expired_certificates}
                  </div>
                </div>
              </div>

              <div class="card-actions justify-end mt-4">
                <.link navigate={~p"/pki/ca/#{ca.id}"} class="btn btn-sm btn-primary">
                  View Details
                </.link>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</Layouts.app>
