<Layouts.app flash={@flash} page_title={@page_title}>
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Certificate Authorities</h1>
      <.link navigate={~p"/pki/ca/new"} class="btn btn-primary">
        Initialize New CA
      </.link>
    </div>

    <%= if @live_action == :new do %>
      <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
          <h2 class="card-title">Initialize New Certificate Authority</h2>
          <.form for={@form_data} phx-submit="initialize_ca" class="space-y-4">
            <div class="form-control">
              <label class="label">
                <span class="label-text">Subject DN</span>
              </label>
              <input
                type="text"
                name="subject"
                value={@form_data["subject"]}
                placeholder="/C=US/O=Example Org/CN=Example CA"
                class="input input-bordered"
                required
              />
              <label class="label">
                <span class="label-text-alt">
                  Format: /C=Country/O=Organization/CN=Common Name
                </span>
              </label>
            </div>

            <div class="grid grid-cols-3 gap-4">
              <div class="form-control">
                <label class="label">
                  <span class="label-text">Key Type</span>
                </label>
                <select name="key_type" class="select select-bordered">
                  <option value="rsa" selected>RSA</option>
                  <option value="ec">EC (Elliptic Curve)</option>
                </select>
              </div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text">Key Size (bits)</span>
                </label>
                <select name="key_size" class="select select-bordered">
                  <option value="2048">2048</option>
                  <option value="3072">3072</option>
                  <option value="4096" selected>4096</option>
                </select>
              </div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text">Validity (days)</span>
                </label>
                <input
                  type="number"
                  name="validity"
                  value={@form_data["validity"]}
                  class="input input-bordered"
                  min="1"
                  max="7300"
                />
              </div>
            </div>

            <div class="alert alert-warning">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-current shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <span>
                Initializing a CA will generate a new private key. Ensure you have secure backup procedures in place!
              </span>
            </div>

            <div class="card-actions justify-end">
              <.link navigate={~p"/pki/ca"} class="btn btn-ghost">Cancel</.link>
              <button type="submit" class="btn btn-primary">Initialize CA</button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <%= if Enum.empty?(@cas) do %>
      <div class="alert alert-info">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="stroke-current shrink-0 w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>No Certificate Authorities found. Initialize your first CA to get started.</span>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= for ca <- @cas do %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">
                {ca.subject}
                <%= if ca.has_private_key do %>
                  <div class="badge badge-success">Key Available</div>
                <% else %>
                  <div class="badge badge-error">No Key</div>
                <% end %>
              </h2>

              <div class="text-sm space-y-2">
                <div>
                  <span class="font-semibold">Key Type:</span>
                  <span class="ml-2">{ca.key_type} {ca.key_size}</span>
                </div>
                <div>
                  <span class="font-semibold">Serial:</span>
                  <span class="ml-2 font-mono text-xs">{ca.serial}</span>
                </div>
                <div>
                  <span class="font-semibold">Valid Until:</span>
                  <span class="ml-2">{Calendar.strftime(ca.not_after, "%Y-%m-%d")}</span>
                </div>
              </div>

              <div class="divider my-2"></div>

              <div class="stats stats-vertical shadow">
                <div class="stat py-2">
                  <div class="stat-title text-xs">Active Certificates</div>
                  <div class="stat-value text-2xl text-success">
                    {ca.stats.active_certificates}
                  </div>
                </div>
                <div class="stat py-2">
                  <div class="stat-title text-xs">Revoked</div>
                  <div class="stat-value text-2xl text-error">
                    {ca.stats.revoked_certificates}
                  </div>
                </div>
                <div class="stat py-2">
                  <div class="stat-title text-xs">Expired</div>
                  <div class="stat-value text-2xl text-warning">
                    {ca.stats.expired_certificates}
                  </div>
                </div>
              </div>

              <div class="card-actions justify-end mt-4">
                <.link navigate={~p"/pki/ca/#{ca.id}"} class="btn btn-sm btn-primary">
                  View Details
                </.link>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</Layouts.app>
