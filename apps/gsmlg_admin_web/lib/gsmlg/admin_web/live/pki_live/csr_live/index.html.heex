<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex flex-col flex-auto mx-auto max-w-screen-2xl px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">CSR Management</h1>
      <.link navigate={~p"/pki/csr/upload"} class="btn btn-primary">Upload CSR</.link>
    </div>

    <%= if @live_action == :upload do %>
      <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
          <h2 class="card-title">Upload Certificate Signing Request</h2>
          <.form for={@upload_form} phx-submit="upload_csr" class="space-y-4">
            <div class="form-control">
              <label class="label"><span class="label-text">Certificate Authority</span></label>
              <select name="ca_id" class="select select-bordered" required>
                <option value="">Select CA...</option>
                <%= for ca <- @cas do %>
                  <option value={ca.id}>{ca.subject}</option>
                <% end %>
              </select>
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text">CSR (PEM Format)</span></label>
              <textarea
                name="csr_pem"
                class="textarea textarea-bordered font-mono text-xs h-48"
                placeholder="-----BEGIN CERTIFICATE REQUEST-----"
                required
              ><%= @upload_form["csr_pem"] %></textarea>
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div class="form-control">
                <label class="label"><span class="label-text">Template</span></label>
                <select name="template" class="select select-bordered">
                  <option value="server">Server</option>
                  <option value="client">Client</option>
                  <option value="code_signing">Code Signing</option>
                  <option value="email">Email</option>
                </select>
              </div>
              <div class="form-control">
                <label class="label"><span class="label-text">Validity (days)</span></label>
                <input
                  type="number"
                  name="validity_days"
                  value={@upload_form["validity_days"]}
                  class="input input-bordered"
                />
              </div>
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text">Notes</span></label>
              <textarea
                name="notes"
                class="textarea textarea-bordered"
                placeholder="Optional notes"
              ><%= @upload_form["notes"] %></textarea>
            </div>
            <div class="card-actions justify-end">
              <.link navigate={~p"/pki/csr"} class="btn btn-ghost">Cancel</.link>
              <button type="submit" class="btn btn-primary">Upload CSR</button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <%= if Enum.empty?(@csr_requests) do %>
      <div class="alert alert-info">No CSR requests found.</div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Subject</th>
              <th>CA</th>
              <th>Template</th>
              <th>Status</th>
              <th>Requested By</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for req <- @csr_requests do %>
              <tr>
                <td class="font-mono text-xs">{req.subject}</td>
                <td class="text-xs">{req.ca_id}</td>
                <td><span class="badge">{req.template}</span></td>
                <td>
                  <span class={[
                    "badge",
                    req.status == :pending && "badge-warning",
                    req.status == :approved && "badge-success",
                    req.status == :rejected && "badge-error",
                    req.status == :issued && "badge-success"
                  ]}>
                    {req.status}
                  </span>
                </td>
                <td class="text-sm">{req.requested_by}</td>
                <td class="text-sm">{Calendar.strftime(req.inserted_at, "%Y-%m-%d")}</td>
                <td>
                  <%= if req.status == :pending do %>
                    <button
                      phx-click="approve_csr"
                      phx-value-id={req.id}
                      class="btn btn-xs btn-success"
                    >
                      Approve
                    </button>
                    <button
                      phx-click="reject_csr"
                      phx-value-id={req.id}
                      phx-value-notes="Rejected"
                      class="btn btn-xs btn-error"
                    >
                      Reject
                    </button>
                  <% end %>
                  <%= if req.certificate_serial do %>
                    <.link
                      navigate={~p"/pki/certificates/#{req.certificate_serial}"}
                      class="btn btn-xs btn-ghost"
                    >
                      View Cert
                    </.link>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</Layouts.app>
