<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex flex-col flex-auto mx-auto max-w-screen-2xl px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">PKI Analytics Dashboard</h1>
      <button phx-click="refresh" class="btn btn-secondary">Refresh Data</button>
    </div>

    <%= if @analytics do %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="stat bg-base-100 shadow-xl rounded-box">
          <div class="stat-title">Total CAs</div>
          <div class="stat-value text-primary">{@analytics.total_cas}</div>
          <div class="stat-desc">Certificate Authorities</div>
        </div>
        <div class="stat bg-base-100 shadow-xl rounded-box">
          <div class="stat-title">Active Certificates</div>
          <div class="stat-value text-success">{@analytics.active_certificates}</div>
          <div class="stat-desc">{@analytics.total_certificates} total</div>
        </div>
        <div class="stat bg-base-100 shadow-xl rounded-box">
          <div class="stat-title">Revoked Certificates</div>
          <div class="stat-value text-error">{@analytics.revoked_certificates}</div>
          <div class="stat-desc">Manually revoked</div>
        </div>
        <div class="stat bg-base-100 shadow-xl rounded-box">
          <div class="stat-title">Expired Certificates</div>
          <div class="stat-value text-warning">{@analytics.expired_certificates}</div>
          <div class="stat-desc">Past expiry date</div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-xl mb-8">
        <div class="card-body">
          <h2 class="card-title">CA Statistics</h2>
          <div class="overflow-x-auto">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>CA Subject</th>
                  <th>Active</th>
                  <th>Revoked</th>
                  <th>Expired</th>
                  <th>Total</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <%= for ca <- @analytics.cas do %>
                  <tr>
                    <td class="font-mono text-xs">{ca.subject}</td>
                    <td class="text-success">{ca.stats.active_certificates}</td>
                    <td class="text-error">{ca.stats.revoked_certificates}</td>
                    <td class="text-warning">{ca.stats.expired_certificates}</td>
                    <td class="font-semibold">
                      {ca.stats.active_certificates + ca.stats.revoked_certificates +
                        ca.stats.expired_certificates}
                    </td>
                    <td>
                      <.link navigate={~p"/pki/ca/#{ca.id}"} class="btn btn-xs btn-ghost">
                        View
                      </.link>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <%= if @expiry_stats do %>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Certificate Expiry Statistics</h2>
            <div class="overflow-x-auto">
              <table class="table table-zebra">
                <thead>
                  <tr>
                    <th>CA</th>
                    <th>Next 7 Days</th>
                    <th>Next 30 Days</th>
                    <th>Next 90 Days</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for stat <- @expiry_stats do %>
                    <tr>
                      <td class="font-mono text-xs">{stat.ca_subject}</td>
                      <td>
                        <span class={[
                          "badge",
                          stat.expiring_7_days > 0 && "badge-error",
                          stat.expiring_7_days == 0 && "badge-success"
                        ]}>
                          {stat.expiring_7_days}
                        </span>
                      </td>
                      <td>
                        <span class={[
                          "badge",
                          stat.expiring_30_days > 0 && "badge-warning",
                          stat.expiring_30_days == 0 && "badge-success"
                        ]}>
                          {stat.expiring_30_days}
                        </span>
                      </td>
                      <td>
                        <span class={[
                          "badge",
                          stat.expiring_90_days > 0 && "badge-info",
                          stat.expiring_90_days == 0 && "badge-success"
                        ]}>
                          {stat.expiring_90_days}
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="alert alert-error">Failed to load analytics data.</div>
    <% end %>
  </div>
</Layouts.app>
