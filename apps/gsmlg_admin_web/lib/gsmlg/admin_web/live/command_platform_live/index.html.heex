<Layouts.app flash={@flash} page_title={@page_title} active_menu="command_platform_legacy">
  <div class="container">
    <div class="flex gap-4 m-4">
      <.dm_btn class="h-8 flex items-center text-teal-400" phx-click="check-table">
        check table
      </.dm_btn>
    </div>
    <.dm_card>
      <:title class="text-2xl text-secondary">Commanders</:title>
      <section class="my-4">
        <ul class="flex flex-col gap-4 list-decimal">
          <li :for={commander <- @commanders} class="flex gap-4">
            <h4 class="font-bold after:content-[':']">Commander</h4>
            <span class="text-primary">{commander.name}</span>
            <.dm_modal>
              <:trigger :let={f}>
                <.dm_btn
                  class="btn-primary btn-sm"
                  onclick={"document.getElementById('#{f}')?.showModal()"}
                >
                  Send Command
                </.dm_btn>
              </:trigger>
              <:title class="px-8">
                Send Command to Commander <span class="text-blue-600 mx-4">{commander.name}</span>
              </:title>
              <:body>
                <.dm_form
                  :let={f}
                  class="w-full p-4"
                  for={@command_form}
                  phx-change="validate"
                  phx-submit="send_command"
                >
                  <input name="commander" type="hidden" value={commander.name} />
                  <.dm_input type="textarea" field={f[:command]} label="Command" />
                  <:actions>
                    <.dm_btn class="w-full" phx-disable-with="Searching...">Send</.dm_btn>
                  </:actions>
                </.dm_form>
              </:body>
            </.dm_modal>
          </li>
        </ul>
      </section>
    </.dm_card>
    <.dm_card>
      <:title class="text-2xl text-secondary">Command Results</:title>
      <section class="my-4">
        <.live_component
          id="command_results"
          module={GSMLG.AdminWeb.ComponentsLive.CommandResults}
        />
      </section>
    </.dm_card>
  </div>
</Layouts.app>
