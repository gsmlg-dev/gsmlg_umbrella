<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div
    id="storage-browser"
    phx-hook="StorageSplitPane"
    class="storage-browser flex flex-col lg:flex-row w-full h-full min-h-0 overflow-hidden"
  >
    <.folder_tree
      nodes={@folder_tree}
      prefix={@prefix}
      expanded={@expanded_folders}
      total_files={@bucket_file_count}
      backend_id={@backend_id}
      folder_errors={@folder_errors}
      busy={not is_nil(@folder_operation)}
    />

    <%!-- TODO(upstream): duskmoon-dev/phoenix-duskmoon-ui#203
    WORKAROUND(upstream): duskmoon-dev/phoenix-duskmoon-ui#203 — local hook adds resizing to dm_divider. --%>
    <.dm_divider
      id="storage-splitter"
      orientation="vertical"
      class="storage-splitter"
      data-storage-splitter
      tabindex="0"
      aria-label="Resize folders panel"
      aria-controls="storage-folder-tree"
      title="Drag to resize folders. Use Left and Right arrow keys."
    >
      <.dm_mdi name="drag-vertical" class="w-3 h-5" />
    </.dm_divider>

    <div
      id="storage-files-panel"
      class="flex-1 flex flex-col gap-4 p-4 sm:p-6 min-w-0 min-h-0 overflow-y-auto"
    >
      <div class="flex shrink-0 flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <h1 class="font-semibold">Files</h1>
          <p class="font-mono text-sm text-base-content/60 break-all">
            {@bucket || "S3"}/{@prefix}
          </p>
        </div>
        <div class="flex w-full lg:w-auto flex-wrap items-center gap-2 min-w-0">
          <form
            id="storage-search"
            phx-submit="search"
            class="flex flex-1 basis-64 min-w-0 items-center gap-2"
          >
            <input
              type="search"
              name="search"
              value={@search}
              placeholder="Search object keys..."
              class="input input-sm input-bordered min-w-0 flex-1"
              aria-label="Search object keys"
            />
            <.dm_btn type="submit" size="sm" variant="ghost">Search</.dm_btn>
          </form>
          <.dm_btn
            id="toggle-storage-upload"
            size="sm"
            variant="ghost"
            phx-click="toggle_upload"
            disabled={is_nil(@backend_id)}
          >
            Upload
          </.dm_btn>
          <.dm_btn
            id="refresh-storage"
            size="sm"
            variant="primary"
            phx-click="refresh"
            disabled={@loading}
          >
            <.dm_mdi name="refresh" class="w-4 h-4" /> Refresh
          </.dm_btn>
        </div>
      </div>

      <form
        id="create-storage-folder"
        phx-submit="create_folder"
        class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 w-full max-w-lg shrink-0"
      >
        <input type="hidden" name="backend" value={@backend_id} />
        <input
          type="text"
          name="folder"
          placeholder="New folder name"
          required
          class="input input-sm input-bordered min-w-0 w-full"
          aria-label="New folder name"
        />
        <.dm_btn type="submit" size="sm" variant="ghost" disabled={is_nil(@backend_id)}>
          Create folder
        </.dm_btn>
      </form>
      <form
        :if={@show_upload}
        id="storage-upload-form"
        phx-change="validate_upload"
        phx-submit="save_upload"
        class="flex shrink-0 flex-col gap-3 border border-base-300 rounded p-4"
      >
        <input type="hidden" name="backend" value={@backend_id} />
        <div class="flex flex-wrap gap-2">
          <input
            name="tenant"
            value={@upload_tenant}
            placeholder="Tenant"
            required
            class="input input-sm input-bordered"
            aria-label="Upload tenant"
          />
          <input
            name="type"
            value={@upload_type}
            placeholder="File type"
            required
            class="input input-sm input-bordered"
            aria-label="Upload file type"
          />
        </div>
        <.live_file_input upload={@uploads.files} />
        <div :for={entry <- @uploads.files.entries} class="flex items-center gap-2 text-sm">
          <span>{entry.client_name} — {entry.progress}%</span>
          <.dm_btn
            type="button"
            size="sm"
            variant="ghost"
            phx-click="cancel_upload"
            phx-value-ref={entry.ref}
          >
            Cancel
          </.dm_btn>
          <span :for={error <- upload_errors(@uploads.files, entry)} class="text-error">{error_to_string(
            error
          )}</span>
        </div>
        <.dm_btn type="submit" size="sm" variant="primary" disabled={is_nil(@backend_id)}>
          Upload files
        </.dm_btn>
      </form>

      <div :if={@stats} class="grid grid-cols-1 md:grid-cols-3 gap-4 shrink-0">
        <.dm_card variant="bordered" padding="sm">
          <div>
            <div class="text-xs text-base-content/50 uppercase">Total Files</div>
            <div class="text-2xl font-bold text-primary mt-1">{@stats.total_files}</div>
          </div>
        </.dm_card>
        <.dm_card variant="bordered" padding="sm">
          <div>
            <div class="text-xs text-base-content/50 uppercase">Total Size</div>
            <div class="text-2xl font-bold text-primary mt-1">
              {format_size(@stats.total_size)}
            </div>
          </div>
        </.dm_card>
        <.dm_card variant="bordered" padding="sm">
          <div>
            <div class="text-xs text-base-content/50 uppercase">Folders</div>
            <div class="text-2xl font-bold text-primary mt-1">{@stats.total_folders}</div>
          </div>
        </.dm_card>
      </div>

      <p :if={@loading} role="status" class="text-sm text-base-content/60 shrink-0">
        Reading files from S3…
      </p>
      <p :if={@folder_operation} role="status" class="text-sm text-base-content/60 shrink-0">
        {if @folder_operation.action == :rename, do: "Renaming folder…", else: "Deleting folder…"}
      </p>
      <p :if={@error} id="storage-error" role="alert" class="text-sm text-error shrink-0">
        {storage_error(@error)}
        <span :if={@refreshed_at}>Showing the last successful listing.</span>
      </p>
      <p :if={@refreshed_at} class="text-xs text-base-content/50 shrink-0">
        Last refreshed: {Calendar.strftime(@refreshed_at, "%Y-%m-%d %H:%M:%S UTC")}
      </p>

      <div class="overflow-x-auto shrink-0">
        <.dm_table
          id="storage-objects"
          data={@streams.objects}
          stream
          compact
          zebra
          hover
          class="w-full min-w-[48rem] [&_thead]:table-header-group"
        >
          <:col :let={object} label="Object Key" class="min-w-64 font-mono text-xs break-all">
            <.link
              navigate={
                ~p"/storage/#{Inventory.encode_key(object.key)}?#{%{backend: @backend_id}}"
              }
              class="text-primary hover:underline"
            >
              {object.key}
            </.link>
          </:col>
          <:col :let={object} label="Size" class="whitespace-nowrap">
            {format_size(object.size)}
          </:col>
          <:col :let={object} label="Last Modified" class="whitespace-nowrap text-xs">
            {object.last_modified}
          </:col>
          <:col :let={object} label="ETag" class="min-w-40 font-mono text-xs break-all">
            {object.etag || "—"}
          </:col>
          <:col :let={object} label="Actions">
            <.dm_btn
              id={object_dom_id(object) <> "-delete"}
              confirm="Are you sure you want to delete this file?"
              size="sm"
              variant="ghost"
              class="text-error"
              confirm_class="btn-error btn-sm"
              cancel_class="btn-ghost btn-sm"
              confirm_title="Delete File"
            >
              Delete
              <:confirm_action>
                <form method="dialog">
                  <.dm_btn
                    phx-click="delete"
                    phx-value-key={Inventory.encode_key(object.key)}
                    phx-value-backend={@backend_id}
                    class="btn-error btn-sm"
                  >
                    Delete
                  </.dm_btn>
                </form>
              </:confirm_action>
            </.dm_btn>
          </:col>
        </.dm_table>
      </div>
      <p
        :if={@files_result && @files_result.total == 0 && !@loading && !@error}
        class="text-sm text-base-content/50 py-8 text-center shrink-0"
      >
        No files in this folder
      </p>
      <div
        :if={@files_result && @files_result.total_pages > 1}
        class="flex shrink-0 flex-wrap justify-center items-center gap-3"
      >
        <.link
          :if={@page > 1}
          patch={~p"/storage?#{filter_params(assigns, page: @page - 1)}"}
          class="btn btn-ghost btn-sm"
        >Previous</.link>
        <span class="text-sm">Page {@page} of {@files_result.total_pages}</span>
        <.link
          :if={@page < @files_result.total_pages}
          patch={~p"/storage?#{filter_params(assigns, page: @page + 1)}"}
          class="btn btn-ghost btn-sm"
        >Next</.link>
      </div>
    </div>
  </div>
</Layouts.app>
