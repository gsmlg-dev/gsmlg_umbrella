<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex w-full h-full overflow-hidden">
    <nav
      class="w-56 flex-none border-r border-base-300 overflow-y-auto p-3 flex flex-col gap-1"
      aria-label="S3 folders"
    >
      <.link
        patch={~p"/storage"}
        class="flex items-center gap-2 p-2 rounded hover:bg-base-200 text-sm"
      >
        <.dm_mdi name="folder-open-outline" class="w-4 h-4" />
        <span>All Files</span>
      </.link>
      <.link
        :if={@prefix != ""}
        patch={~p"/storage?#{%{prefix: parent_prefix(@prefix)}}"}
        class="flex items-center gap-2 p-2 rounded hover:bg-base-200 text-sm"
      >
        <.dm_mdi name="arrow-up" class="w-4 h-4" />
        <span>Parent folder</span>
      </.link>
      <.link
        :for={folder <- @folders}
        patch={~p"/storage?#{%{prefix: folder.prefix}}"}
        class="flex items-center gap-2 p-2 rounded hover:bg-base-200 text-sm"
        title={folder.prefix}
      >
        <.dm_mdi name="folder-outline" class="w-4 h-4 shrink-0 text-primary" />
        <span class="truncate">{folder.name}</span>
        <span class="ml-auto text-xs text-base-content/50">{folder.count}</span>
      </.link>
    </nav>

    <div class="flex-1 flex flex-col gap-4 p-6 min-w-0 overflow-auto">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <h1 class="font-semibold">Files</h1>
          <p class="font-mono text-sm text-base-content/60 break-all">
            {@bucket || "S3"}/{@prefix}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <form id="storage-search" phx-submit="search" class="flex gap-2">
            <input
              type="search"
              name="search"
              value={@search}
              placeholder="Search object keys..."
              class="input input-sm input-bordered"
              aria-label="Search object keys"
            />
            <.dm_btn type="submit" size="sm" variant="ghost">Search</.dm_btn>
          </form>
          <.dm_btn
            id="toggle-storage-upload"
            size="sm"
            variant="ghost"
            phx-click="toggle_upload"
            disabled={is_nil(@backend_id)}
          >
            Upload
          </.dm_btn>
          <.dm_btn
            id="refresh-storage"
            size="sm"
            variant="primary"
            phx-click="refresh"
            disabled={@loading}
          >
            <.dm_mdi name="refresh" class="w-4 h-4" /> Refresh
          </.dm_btn>
        </div>
      </div>

      <form
        id="create-storage-folder"
        phx-submit="create_folder"
        class="flex flex-wrap items-center gap-2"
      >
        <input type="hidden" name="backend" value={@backend_id} />
        <input
          type="text"
          name="folder"
          placeholder="New folder name"
          required
          class="input input-sm input-bordered"
          aria-label="New folder name"
        />
        <.dm_btn type="submit" size="sm" variant="ghost" disabled={is_nil(@backend_id)}>
          Create folder
        </.dm_btn>
      </form>
      <form
        :if={@show_upload}
        id="storage-upload-form"
        phx-change="validate_upload"
        phx-submit="save_upload"
        class="flex flex-col gap-3 border border-base-300 rounded p-4"
      >
        <input type="hidden" name="backend" value={@backend_id} />
        <div class="flex flex-wrap gap-2">
          <input
            name="tenant"
            value={@upload_tenant}
            placeholder="Tenant"
            required
            class="input input-sm input-bordered"
            aria-label="Upload tenant"
          />
          <input
            name="type"
            value={@upload_type}
            placeholder="File type"
            required
            class="input input-sm input-bordered"
            aria-label="Upload file type"
          />
        </div>
        <.live_file_input upload={@uploads.files} />
        <div :for={entry <- @uploads.files.entries} class="flex items-center gap-2 text-sm">
          <span>{entry.client_name} — {entry.progress}%</span>
          <.dm_btn
            type="button"
            size="sm"
            variant="ghost"
            phx-click="cancel_upload"
            phx-value-ref={entry.ref}
          >
            Cancel
          </.dm_btn>
          <span :for={error <- upload_errors(@uploads.files, entry)} class="text-error">{error_to_string(
            error
          )}</span>
        </div>
        <.dm_btn type="submit" size="sm" variant="primary" disabled={is_nil(@backend_id)}>
          Upload files
        </.dm_btn>
      </form>

      <div :if={@stats} class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <.dm_card variant="bordered">
          <div class="p-4">
            <div class="text-xs text-base-content/50 uppercase">Total Files</div>
            <div class="text-2xl font-bold text-primary mt-1">{@stats.total_files}</div>
          </div>
        </.dm_card>
        <.dm_card variant="bordered">
          <div class="p-4">
            <div class="text-xs text-base-content/50 uppercase">Total Size</div>
            <div class="text-2xl font-bold text-primary mt-1">
              {format_size(@stats.total_size)}
            </div>
          </div>
        </.dm_card>
        <.dm_card variant="bordered">
          <div class="p-4">
            <div class="text-xs text-base-content/50 uppercase">Folders</div>
            <div class="text-2xl font-bold text-primary mt-1">{@stats.total_folders}</div>
          </div>
        </.dm_card>
      </div>

      <p :if={@loading} role="status" class="text-sm text-base-content/60">
        Reading files from S3…
      </p>
      <p :if={@error} id="storage-error" role="alert" class="text-sm text-error">
        {storage_error(@error)}
        <span :if={@refreshed_at}>Showing the last successful listing.</span>
      </p>
      <p :if={@refreshed_at} class="text-xs text-base-content/50">
        Last refreshed: {Calendar.strftime(@refreshed_at, "%Y-%m-%d %H:%M:%S UTC")}
      </p>

      <div class="overflow-x-auto">
        <table class="table table-sm w-full">
          <thead>
            <tr>
              <th>Object Key</th><th>Size</th><th>Last Modified</th><th>ETag</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="storage-objects" phx-update="stream">
            <tr :for={{dom_id, object} <- @streams.objects} id={dom_id}>
              <td class="font-mono text-xs break-all">
                <.link
                  navigate={
                    ~p"/storage/#{Inventory.encode_key(object.key)}?#{%{backend: @backend_id}}"
                  }
                  class="text-primary hover:underline"
                >
                  {object.key}
                </.link>
              </td>
              <td class="whitespace-nowrap">{format_size(object.size)}</td>
              <td class="whitespace-nowrap text-xs">{object.last_modified}</td>
              <td class="font-mono text-xs break-all">{object.etag || "—"}</td>
              <td>
                <.dm_btn
                  id={object_dom_id(object) <> "-delete"}
                  confirm="Are you sure you want to delete this file?"
                  size="sm"
                  variant="ghost"
                  class="text-error"
                  confirm_class="btn-error btn-sm"
                  cancel_class="btn-ghost btn-sm"
                  confirm_title="Delete File"
                >
                  Delete
                  <:confirm_action>
                    <form method="dialog">
                      <.dm_btn
                        phx-click="delete"
                        phx-value-key={Inventory.encode_key(object.key)}
                        phx-value-backend={@backend_id}
                        class="btn-error btn-sm"
                      >
                        Delete
                      </.dm_btn>
                    </form>
                  </:confirm_action>
                </.dm_btn>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p
        :if={@files_result && @files_result.total == 0 && !@loading && !@error}
        class="text-sm text-base-content/50 py-8 text-center"
      >
        No files in this folder
      </p>
      <div
        :if={@files_result && @files_result.total_pages > 1}
        class="flex justify-center items-center gap-3"
      >
        <.link
          :if={@page > 1}
          patch={~p"/storage?#{filter_params(assigns, page: @page - 1)}"}
          class="btn btn-ghost btn-sm"
        >Previous</.link>
        <span class="text-sm">Page {@page} of {@files_result.total_pages}</span>
        <.link
          :if={@page < @files_result.total_pages}
          patch={~p"/storage?#{filter_params(assigns, page: @page + 1)}"}
          class="btn btn-ghost btn-sm"
        >Next</.link>
      </div>
    </div>
  </div>
</Layouts.app>
