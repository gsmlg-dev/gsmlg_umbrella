<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex flex-col gap-4 p-6 w-full max-w-5xl">
    <%!-- Header --%>
    <div class="flex items-center gap-3">
      <.dm_mdi name="file-outline" class="w-5 h-5 text-primary" />
      <h1 class="font-semibold text-base-content">{@file.filename}</h1>
      <span class={"badge badge-sm #{if @file.status == "active", do: "badge-success", else: "badge-error"}"}>
        {@file.status}
      </span>
    </div>

    <%!-- Actions --%>
    <div class="flex gap-2">
      <.link navigate={~p"/storage"}>
        <.dm_btn size="sm" variant="ghost">
          <.dm_mdi name="arrow-left" class="w-4 h-4" /> All Files
        </.dm_btn>
      </.link>
      <.dm_btn
        size="sm"
        variant="ghost"
        id="copy-url-btn"
        phx-click={JS.dispatch("phx:copy", to: "#public-url-input")}
      >
        <.dm_mdi name="content-copy" class="w-4 h-4" /> Copy URL
      </.dm_btn>
      <.dm_btn
        :if={String.starts_with?(@file.content_type, "image/")}
        size="sm"
        variant="ghost"
        phx-click="regenerate_variants"
      >
        <.dm_mdi name="refresh" class="w-4 h-4" /> Regenerate Variants
      </.dm_btn>
      <.dm_btn
        confirm="Are you sure you want to delete this file?"
        size="sm"
        variant="ghost"
        class="text-error"
        confirm_class="btn-error btn-sm"
        cancel_class="btn-ghost btn-sm"
        confirm_title="Delete File"
      >
        <.dm_mdi name="trash-can-outline" class="w-4 h-4" /> Delete
        <:confirm_action>
          <form method="dialog">
            <.dm_btn phx-click="delete" class="btn-error btn-sm">Delete</.dm_btn>
          </form>
        </:confirm_action>
      </.dm_btn>
    </div>

    <input id="public-url-input" type="hidden" value={"/files/#{@file.id}"} />

    <%!-- File Details --%>
    <.dm_card variant="bordered" body_class="p-0">
      <dl class="divide-y divide-base-200 text-sm">
        <%= for {label, value} <- [
          {"ID", @file.id},
          {"Tenant", @file.tenant},
          {"Type", @file.type},
          {"Filename", @file.filename},
          {"Content Type", @file.content_type},
          {"Size", format_size(@file.size)},
          {"Checksum", @file.checksum},
          {"S3 Key", @file.s3_key},
          {"Status", @file.status},
          {"Uploaded By", @file.uploaded_by || "—"},
          {"Created", Calendar.strftime(@file.inserted_at, "%Y-%m-%d %H:%M:%S UTC")},
          {"Updated", Calendar.strftime(@file.updated_at, "%Y-%m-%d %H:%M:%S UTC")}
        ] do %>
          <div class="flex px-4 py-2.5 gap-4">
            <dt class="w-28 shrink-0 font-mono text-xs text-base-content/45 uppercase tracking-wide pt-0.5">
              {label}
            </dt>
            <dd class="flex-1 font-mono text-xs text-base-content break-all">
              {value}
            </dd>
          </div>
        <% end %>
      </dl>
    </.dm_card>

    <%!-- Preview --%>
    <div :if={String.starts_with?(@file.content_type, "image/")} class="flex flex-col gap-3">
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">Original</div>
      <div class="border border-base-300 rounded-lg p-4 bg-base-200/50">
        <img src={"/files/#{@file.id}"} alt={@file.filename} class="max-w-full max-h-96 mx-auto" />
      </div>
    </div>

    <%!-- Variants --%>
    <div :if={map_size(@file.variants || %{}) > 0} class="flex flex-col gap-3">
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">Variants</div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <%= for {name, variant} <- @file.variants do %>
          <.dm_card variant="bordered">
            <div class="p-3 flex flex-col gap-2">
              <div class="font-mono text-xs font-bold">{name}</div>
              <div
                :if={String.starts_with?(variant["content_type"] || @file.content_type, "image/")}
                class="bg-base-200/50 rounded p-2"
              >
                <img
                  src={"/files/#{@file.id}/v/#{name}"}
                  alt={"#{@file.filename} - #{name}"}
                  class="max-w-full max-h-48 mx-auto"
                />
              </div>
              <div class="text-xs text-base-content/60">
                <span>Size: {format_size(variant["size"])}</span>
              </div>
            </div>
          </.dm_card>
        <% end %>
      </div>
    </div>

    <%!-- Metadata --%>
    <div :if={map_size(@file.metadata || %{}) > 0} class="flex flex-col gap-3">
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">Metadata</div>
      <.dm_card variant="bordered" body_class="p-0">
        <el-dm-code-block language="json" copyable borderless>
          <pre><code><el-gsmlg-json>{JSON.encode!(@file.metadata)}</el-gsmlg-json></code></pre>
        </el-dm-code-block>
      </.dm_card>
    </div>
  </div>
</Layouts.app>
