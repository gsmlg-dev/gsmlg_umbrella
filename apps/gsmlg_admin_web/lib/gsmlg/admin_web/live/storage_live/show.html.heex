<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div class="flex flex-col gap-4 p-6 w-full max-w-5xl">
    <div class="flex items-center gap-3">
      <.dm_mdi name="file-outline" class="w-5 h-5 text-primary" />
      <h1 class="font-semibold text-base-content break-all">{@object.key}</h1>
    </div>
    <div class="flex gap-2">
      <.link navigate={~p"/storage"}><.dm_btn size="sm" variant="ghost">All Files</.dm_btn></.link>
      <.dm_btn
        :if={@managed_file}
        size="sm"
        variant="ghost"
        id="copy-url-btn"
        phx-click={JS.dispatch("phx:copy", to: "#public-url-input")}
      >
        Copy URL
      </.dm_btn>
      <.dm_btn
        :if={@managed_file && String.starts_with?(@object.content_type, "image/")}
        size="sm"
        variant="ghost"
        phx-click="regenerate_variants"
        phx-value-backend={@backend_id}
      >
        Regenerate Variants
      </.dm_btn>
      <.dm_btn
        id="show-delete-storage"
        confirm="Are you sure you want to delete this file?"
        size="sm"
        variant="ghost"
        class="text-error"
        confirm_class="btn-error btn-sm"
        cancel_class="btn-ghost btn-sm"
        confirm_title="Delete File"
      >
        <.dm_mdi name="trash-can-outline" class="w-4 h-4" /> Delete
        <:confirm_action>
          <form method="dialog">
            <.dm_btn
              id="delete-storage-object"
              phx-click="delete"
              phx-value-backend={@backend_id}
              class="btn-error btn-sm"
            >
              Delete
            </.dm_btn>
          </form>
        </:confirm_action>
      </.dm_btn>
    </div>
    <input
      :if={@managed_file}
      id="public-url-input"
      type="hidden"
      value={"/files/#{@managed_file.id}"}
    />
    <.dm_card variant="bordered" body_class="p-0">
      <dl id="storage-object-details" class="divide-y divide-base-200 text-sm">
        <%= for {label, value} <- [{"Bucket", @bucket}, {"S3 Key", @object.key}, {"Content Type", @object.content_type}, {"Size", format_size(@object.size)}, {"ETag", @object.etag || "—"}, {"Last Modified", @object.last_modified || "—"}] do %>
          <div class="flex px-4 py-2.5 gap-4">
            <dt class="w-28 shrink-0 font-mono text-xs text-base-content/45 uppercase tracking-wide pt-0.5">
              {label}
            </dt><dd class="flex-1 font-mono text-xs text-base-content break-all">{value}</dd>
          </div>
        <% end %>
      </dl>
    </.dm_card>
    <div
      :if={@managed_file && String.starts_with?(@object.content_type, "image/")}
      class="border border-base-300 rounded-lg p-4 bg-base-200/50"
    >
      <img
        src={"/files/#{@managed_file.id}"}
        alt={@object.key}
        class="max-w-full max-h-96 mx-auto"
      />
    </div>
    <div
      :if={@managed_file && map_size(@managed_file.variants || %{}) > 0}
      class="flex flex-col gap-3"
    >
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">Variants</div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <.dm_card :for={{name, variant} <- @managed_file.variants} variant="bordered">
          <div class="p-3 flex flex-col gap-2">
            <div class="font-mono text-xs font-bold">{name}</div>
            <img
              :if={String.starts_with?(variant["content_type"] || @object.content_type, "image/")}
              src={"/files/#{@managed_file.id}/v/#{name}"}
              alt={"#{@object.key} - #{name}"}
              class="max-w-full max-h-48 mx-auto"
            />
            <div class="text-xs text-base-content/60">Size: {format_size(variant["size"])}</div>
          </div>
        </.dm_card>
      </div>
    </div>
    <div :if={@managed_file} class="flex flex-col gap-3">
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">
        Managed File
      </div>
      <.dm_card variant="bordered" body_class="p-0">
        <dl class="divide-y divide-base-200 text-sm">
          <%= for {label, value} <- [{"ID", @managed_file.id}, {"Tenant", @managed_file.tenant}, {"Type", @managed_file.type}, {"Filename", @managed_file.filename}, {"Checksum", @managed_file.checksum || "—"}, {"Uploaded By", @managed_file.uploaded_by || "—"},
              {"Created", Calendar.strftime(@managed_file.inserted_at, "%Y-%m-%d %H:%M:%S UTC")},
              {"Updated", Calendar.strftime(@managed_file.updated_at, "%Y-%m-%d %H:%M:%S UTC")}] do %>
            <div class="flex px-4 py-2.5 gap-4">
              <dt class="w-28 shrink-0 font-mono text-xs text-base-content/45 uppercase tracking-wide pt-0.5">
                {label}
              </dt><dd class="flex-1 font-mono text-xs text-base-content break-all">{value}</dd>
            </div>
          <% end %>
        </dl>
      </.dm_card>
    </div>
    <div
      :if={@managed_file && map_size(@managed_file.metadata || %{}) > 0}
      class="flex flex-col gap-3"
    >
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">
        Managed Metadata
      </div>
      <.dm_card variant="bordered" body_class="p-0">
        <el-dm-code-block language="json" copyable borderless>
          <pre><code><el-gsmlg-json>{JSON.encode!(@managed_file.metadata)}</el-gsmlg-json></code></pre>
        </el-dm-code-block>
      </.dm_card>
    </div>
    <div :if={map_size(@object.metadata) > 0} class="flex flex-col gap-3">
      <div class="font-mono text-xs text-base-content/45 uppercase tracking-wide">
        S3 Metadata
      </div>
      <.dm_card variant="bordered" body_class="p-0">
        <el-dm-code-block language="json" copyable borderless>
          <pre><code><el-gsmlg-json>{JSON.encode!(@object.metadata)}</el-gsmlg-json></code></pre>
        </el-dm-code-block>
      </.dm_card>
    </div>
  </div>
</Layouts.app>
