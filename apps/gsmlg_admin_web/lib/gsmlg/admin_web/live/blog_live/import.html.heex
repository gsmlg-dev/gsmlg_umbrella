<Layouts.app flash={@flash} page_title={@page_title} active_menu={@active_menu}>
  <div :if={@live_action == :import} class="flex flex-col gap-6 p-6 w-full max-w-3xl">
    <%!-- ── Header ─────────────────────────────────────────────── --%>
    <div class="flex items-center gap-3">
      <.dm_mdi name="database-import-outline" class="w-5 h-5 text-primary" />
      <h1 class="font-semibold text-base-content">{@page_title}</h1>
    </div>

    <%!-- ── Navigation ─────────────────────────────────────────── --%>
    <div class="flex gap-2">
      <.link navigate={~p"/blogs"}>
        <.dm_btn size="sm" variant="ghost">
          <.dm_mdi name="arrow-left" class="w-4 h-4" /> All Blogs
        </.dm_btn>
      </.link>
    </div>

    <%!-- ── Info card ──────────────────────────────────────────── --%>
    <.dm_card variant="bordered" class="border-info/40 bg-info/5">
      <:title>
        <div class="flex items-center gap-2 text-info text-sm font-medium">
          <.dm_mdi name="information-outline" class="w-4 h-4" /> JSON Import Format
        </div>
      </:title>
      <div class="flex flex-col gap-3 text-sm text-base-content/70">
        <p>Paste a JSON array of blog objects. Required fields per entry:</p>
        <div class="flex flex-wrap gap-1.5">
          <.dm_badge size="sm" class="badge-primary">id</.dm_badge>
          <.dm_badge size="sm" class="badge-secondary">title</.dm_badge>
          <.dm_badge variant="ghost" size="sm">slug</.dm_badge>
          <.dm_badge variant="ghost" size="sm">date</.dm_badge>
          <.dm_badge variant="ghost" size="sm">author</.dm_badge>
          <.dm_badge variant="ghost" size="sm">content</.dm_badge>
        </div>
        <p class="text-xs text-base-content/50">
          <.dm_mdi name="refresh" class="w-3 h-3 inline-block align-middle" />
          Existing records with matching IDs are updated (upsert).
        </p>
      </div>
    </.dm_card>

    <%!-- ── Form ──────────────────────────────────────────────── --%>
    <.dm_form
      :let={f}
      for={@changeset}
      id="import-blog-form"
      class="flex flex-col gap-4 w-full"
      method={:post}
      phx-change="validate"
      phx-submit="save"
    >
      <.dm_input
        field={f[:data]}
        type="textarea"
        label="JSON Data"
        rows="18"
        placeholder={"[\n  {\n    \"id\": 1,\n    \"title\": \"...\",\n    \"slug\": \"...\",\n    \"date\": \"2024-01-01\",\n    \"author\": \"...\",\n    \"content\": \"...\"\n  }\n]"}
        class="font-mono text-sm w-full"
        variant="bordered"
      />
      <:actions>
        <div class="flex items-center gap-3">
          <button type="submit" class="btn btn-primary" phx-disable-with="Importing…">
            <.dm_mdi name="database-import-outline" class="w-4 h-4" /> Import
          </button>
          <.link navigate={~p"/blogs"}>
            <.dm_btn size="sm" variant="ghost">Cancel</.dm_btn>
          </.link>
        </div>
      </:actions>
    </.dm_form>
  </div>
</Layouts.app>
