<Layouts.app flash={@flash}>
  <div class="flex flex-col gap-8 p-6 w-full">
    <%!-- ── Content Overview ─────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="view-dashboard-outline" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">Content Overview</h2>
      </div>
      <div class="flex flex-wrap gap-4">
        <.link navigate={~p"/users"}>
          <.dm_stat title="Users" value={to_string(@data.user_count)} class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="account-group-outline" class="w-8 h-8 text-primary" /></:icon>
          </.dm_stat>
        </.link>
        <.link navigate={~p"/user_tokens"}>
          <.dm_stat title="Active Sessions" value={to_string(@data.token_count)} class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="key-outline" class="w-8 h-8 text-secondary" /></:icon>
          </.dm_stat>
        </.link>
        <.link navigate={~p"/blogs"}>
          <.dm_stat title="Blog Posts" value={to_string(@data.blog_count)} class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="post-outline" class="w-8 h-8 text-accent" /></:icon>
          </.dm_stat>
        </.link>
        <.link navigate={~p"/github"}>
          <.dm_stat title="GitHub" value="Repos" class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="github" class="w-8 h-8 text-base-content/60" /></:icon>
          </.dm_stat>
        </.link>
        <.link navigate={~p"/bumblebee/stt"}>
          <.dm_stat title="Bumblebee" value="STT" class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="microphone-outline" class="w-8 h-8 text-info" /></:icon>
          </.dm_stat>
        </.link>
      </div>
    </section>

    <%!-- ── Cluster Overview ─────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="server-network" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">Cluster Overview</h2>
      </div>
      <div class="flex flex-wrap gap-4">
        <.link navigate={~p"/node_management"}>
          <.dm_stat title="Nodes" value={Node.list() |> length() |> to_string()} class="cursor-pointer hover:bg-base-200 transition-colors rounded-box p-4">
            <:icon><.dm_mdi name="server-outline" class="w-8 h-8 text-success" /></:icon>
          </.dm_stat>
        </.link>
      </div>
    </section>

    <%!-- ── Command Platform ─────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="console-line" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">Command Platform</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <.link navigate={~p"/command_platform"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="console" class="w-5 h-5 text-primary" />
              <span class="text-sm font-medium">Commander</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/mnesia"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="database-outline" class="w-5 h-5 text-secondary" />
              <span class="text-sm font-medium">Mnesia</span>
            </div>
          </.dm_card>
        </.link>
      </div>
    </section>

    <%!-- ── AWS ────────────────────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="aws" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">AWS</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <.link navigate={~p"/aws/dynamo_db"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="table-large" class="w-5 h-5 text-warning" />
              <span class="text-sm font-medium">DynamoDB</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/aws/route53/hosted_zones"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="dns-outline" class="w-5 h-5 text-info" />
              <span class="text-sm font-medium">Route 53</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/aws/s3/buckets"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="bucket-outline" class="w-5 h-5 text-success" />
              <span class="text-sm font-medium">S3</span>
            </div>
          </.dm_card>
        </.link>
      </div>
    </section>

    <%!-- ── Caddy ────────────────────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="shield-check-outline" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">Caddy</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <.link navigate={~p"/caddy"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="view-dashboard-outline" class="w-5 h-5 text-primary" />
              <span class="text-sm font-medium">Dashboard</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/caddy/config"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="text-box-outline" class="w-5 h-5 text-secondary" />
              <span class="text-sm font-medium">Configuration</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/caddy/server"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="cog-outline" class="w-5 h-5 text-warning" />
              <span class="text-sm font-medium">Server Control</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/caddy/metrics"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="chart-bar" class="w-5 h-5 text-success" />
              <span class="text-sm font-medium">Metrics</span>
            </div>
          </.dm_card>
        </.link>
        <.link navigate={~p"/caddy/logs"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="file-search-outline" class="w-5 h-5 text-info" />
              <span class="text-sm font-medium">Logs</span>
            </div>
          </.dm_card>
        </.link>
      </div>
    </section>

    <%!-- ── Dashboard ─────────────────────────────────────────────── --%>
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <.dm_mdi name="chart-line" class="w-5 h-5 text-primary" />
        <h2 class="font-semibold text-base-content">Dashboard</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <.link navigate={~p"/live_dashboard"}>
          <.dm_card variant="bordered" body_class="" class="cursor-pointer hover:border-primary transition-colors w-48">
            <div class="flex items-center gap-3 py-1">
              <.dm_mdi name="monitor-dashboard" class="w-5 h-5 text-primary" />
              <span class="text-sm font-medium">Live Dashboard</span>
            </div>
          </.dm_card>
        </.link>
      </div>
    </section>
  </div>
</Layouts.app>
