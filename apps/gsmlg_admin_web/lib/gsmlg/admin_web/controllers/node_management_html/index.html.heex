<Layouts.app flash={@flash} page_title={@page_title} active_menu="node_management">
  <div class="min-h-full bg-surface text-on-surface">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 p-4 lg:p-6">
      <section class="rounded-lg border border-outline-variant bg-surface-container p-4">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
          <div class="min-w-0">
            <p class="text-xs font-semibold uppercase text-on-surface-variant">
              Distributed Erlang
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <h1 class="text-3xl font-bold leading-tight">Node Management</h1>
              <.dm_badge
                variant={if Map.get(@node_state, :alive?), do: "success", else: "warning"}
                soft
              >
                {if Map.get(@node_state, :alive?), do: "started", else: "stopped"}
              </.dm_badge>
              <.dm_badge
                variant={if Map.get(@cluster_status, :running?), do: "success", else: "neutral"}
                soft
              >
                {if Map.get(@cluster_status, :running?),
                  do: "cluster running",
                  else: "cluster idle"}
              </.dm_badge>
            </div>
          </div>

          <div class="grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-3 lg:min-w-[34rem]">
            <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
              <p class="text-xs text-on-surface-variant">Current node</p>
              <p class="mt-1 truncate font-mono text-sm font-semibold">
                {Map.get(@node_state, :self, Node.self())}
              </p>
            </div>
            <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
              <p class="text-xs text-on-surface-variant">Connected</p>
              <p class="mt-1 font-mono text-sm font-semibold">{length(@nodes)}</p>
            </div>
            <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
              <p class="text-xs text-on-surface-variant">Strategy</p>
              <p class="mt-1 truncate font-mono text-sm font-semibold">
                {@cluster_status.config.strategy}
              </p>
            </div>
          </div>
        </div>
      </section>

      <el-dm-tabs
        id="node-management-tabs"
        value="cluster-topology"
        variant="underline"
        aria-label="Node management sections"
        class="block"
      >
        <el-dm-tab tab-id="cluster-topology" active>
          <span class="inline-flex items-center gap-2">
            <.dm_mdi name="lan" class="h-4 w-4" />
            <span>Cluster Topology</span>
          </span>
        </el-dm-tab>
        <el-dm-tab tab-id="manual-node-controls">
          <span class="inline-flex items-center gap-2">
            <.dm_mdi name="server-network" class="h-4 w-4" />
            <span>Manual Node Controls</span>
          </span>
        </el-dm-tab>
        <el-dm-tab tab-id="libcluster-config">
          <span class="inline-flex items-center gap-2">
            <.dm_mdi name="cog-transfer" class="h-4 w-4" />
            <span>Libcluster Configuration</span>
          </span>
        </el-dm-tab>

        <el-dm-tab-panel panel-for="cluster-topology" active>
          <.dm_card variant="bordered" class="bg-surface-container" body_class="space-y-4">
            <:title>
              <div class="flex items-center justify-between gap-3">
                <div class="flex min-w-0 items-center gap-2">
                  <.dm_mdi name="lan" class="h-5 w-5 text-primary" />
                  <span class="text-lg font-semibold">Cluster Topology</span>
                </div>
                <.dm_badge
                  variant={
                    if Map.get(@cluster_status.config, :enabled), do: "success", else: "neutral"
                  }
                  soft
                >
                  {if Map.get(@cluster_status.config, :enabled), do: "enabled", else: "disabled"}
                </.dm_badge>
              </div>
            </:title>

            <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="text-xs text-on-surface-variant">Topology</p>
                <p class="mt-1 truncate font-mono text-sm font-semibold">
                  {@cluster_status.config.topology_name}
                </p>
              </div>
              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="text-xs text-on-surface-variant">Reconnect</p>
                <p class="mt-1 font-mono text-sm font-semibold">
                  {@cluster_status.config.connect_interval} ms
                </p>
              </div>
              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="text-xs text-on-surface-variant">Supervisor</p>
                <p class="mt-1 truncate font-mono text-sm font-semibold">
                  {if Map.get(@cluster_status, :running?),
                    do: inspect(@cluster_status.supervisor),
                    else: "not started"}
                </p>
              </div>
            </div>

            <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
              <div class="mb-2 flex items-center justify-between gap-3">
                <p class="text-sm font-semibold">Configured libcluster topologies</p>
                <span class="font-mono text-xs text-on-surface-variant">
                  {length(@cluster_status.topologies)}
                </span>
              </div>
              <%= if @cluster_status.topologies == [] do %>
                <p class="text-sm text-on-surface-variant">
                  No libcluster topology is configured.
                </p>
              <% else %>
                <div class="flex flex-col gap-2">
                  <div
                    :for={{name, spec} <- @cluster_status.topologies}
                    class="grid grid-cols-1 gap-2 rounded-lg border border-outline-variant bg-surface p-3 md:grid-cols-[10rem_minmax(0,1fr)]"
                  >
                    <div class="min-w-0">
                      <p class="text-xs text-on-surface-variant">Name</p>
                      <p class="truncate font-mono text-sm font-semibold">{name}</p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-on-surface-variant">Strategy</p>
                      <p class="truncate font-mono text-sm">{inspect(spec[:strategy])}</p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
              <div class="mb-2 flex items-center justify-between gap-3">
                <p class="text-sm font-semibold">Connected nodes</p>
                <span class="font-mono text-xs text-on-surface-variant">{length(@nodes)}</span>
              </div>
              <%= if @nodes == [] do %>
                <p class="text-sm text-on-surface-variant">No connected nodes.</p>
              <% else %>
                <div class="flex flex-wrap gap-2">
                  <.dm_badge :for={node <- @nodes} variant="primary" outline>
                    {node}
                  </.dm_badge>
                </div>
              <% end %>
            </div>
          </.dm_card>
        </el-dm-tab-panel>

        <el-dm-tab-panel panel-for="manual-node-controls">
          <.dm_card variant="bordered" class="bg-surface-container" body_class="space-y-4">
            <:title>
              <div class="flex items-center gap-2">
                <.dm_mdi name="server-network" class="h-5 w-5 text-primary" />
                <span class="text-lg font-semibold">Manual Node Controls</span>
              </div>
            </:title>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <div class="mb-3 flex items-center justify-between gap-3">
                  <div>
                    <p class="text-sm font-semibold">Current node</p>
                    <p class="font-mono text-xs text-on-surface-variant">
                      {Map.get(@node_state, :self, Node.self())}
                    </p>
                  </div>
                  <.dm_badge
                    variant={if Map.get(@node_state, :alive?), do: "success", else: "warning"}
                    soft
                  >
                    {if Map.get(@node_state, :alive?), do: "alive", else: "down"}
                  </.dm_badge>
                </div>

                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                  <.dm_form for={to_form(%{})} action={~p"/node_management"} method="post">
                    <input type="hidden" name="action" value="start-node" />
                    <:actions>
                      <.dm_btn type="submit" variant="primary" class="w-full">
                        <:prefix><.dm_mdi name="play" class="h-4 w-4" /></:prefix>
                        Start
                      </.dm_btn>
                    </:actions>
                  </.dm_form>

                  <.dm_form for={to_form(%{})} action={~p"/node_management"} method="post">
                    <input type="hidden" name="action" value="stop-node" />
                    <:actions>
                      <.dm_btn type="submit" variant="outline" class="w-full">
                        <:prefix><.dm_mdi name="stop" class="h-4 w-4" /></:prefix>
                        Stop
                      </.dm_btn>
                    </:actions>
                  </.dm_form>
                </div>
              </div>

              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="mb-3 text-sm font-semibold">Cookie</p>
                <.dm_form
                  :let={f}
                  for={to_form(%{})}
                  action={~p"/node_management"}
                  method="post"
                  class="flex flex-col gap-3"
                >
                  <input type="hidden" name="action" value="set-node-cookie" />
                  <.dm_input
                    field={f[:cookie]}
                    type="password"
                    label="Node cookie"
                    value={to_string(Node.get_cookie())}
                    autocomplete="off"
                  />
                  <:actions>
                    <.dm_btn type="submit" variant="secondary" class="w-full">
                      <:prefix><.dm_mdi name="cookie" class="h-4 w-4" /></:prefix>
                      Set Cookie
                    </.dm_btn>
                  </:actions>
                </.dm_form>
              </div>
            </div>

            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="mb-3 text-sm font-semibold">Connect node</p>
                <.dm_form
                  :let={f}
                  for={to_form(%{})}
                  action={~p"/node_management"}
                  method="post"
                  class="flex flex-col gap-3"
                >
                  <input type="hidden" name="action" value="connect-node" />
                  <.dm_input
                    field={f[:target_node]}
                    type="text"
                    label="Target node"
                    placeholder="gsmlg@10.100.10.10"
                  />
                  <:actions>
                    <.dm_btn type="submit" variant="secondary" class="w-full">
                      <:prefix><.dm_mdi name="connection" class="h-4 w-4" /></:prefix>
                      Connect
                    </.dm_btn>
                  </:actions>
                </.dm_form>
              </div>

              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <div class="mb-3 flex items-center justify-between gap-3">
                  <p class="text-sm font-semibold">Tracked nodes</p>
                  <span class="font-mono text-xs text-on-surface-variant">
                    {length(@tracked_nodes)}
                  </span>
                </div>
                <%= if @tracked_nodes == [] do %>
                  <p class="text-sm text-on-surface-variant">No tracked nodes.</p>
                <% else %>
                  <div class="flex flex-col gap-2">
                    <.dm_form
                      :for={node <- @tracked_nodes}
                      for={to_form(%{})}
                      action={~p"/node_management"}
                      method="post"
                      class="flex items-center justify-between gap-3 rounded-lg border border-outline-variant bg-surface p-2"
                    >
                      <input type="hidden" name="action" value="disconnect-node" />
                      <input type="hidden" name="target_node" value={node} />
                      <span class="min-w-0 truncate font-mono text-sm">{node}</span>
                      <:actions>
                        <.dm_btn type="submit" variant="ghost" size="sm">
                          Disconnect
                        </.dm_btn>
                      </:actions>
                    </.dm_form>
                  </div>
                <% end %>
              </div>
            </div>
          </.dm_card>
        </el-dm-tab-panel>

        <el-dm-tab-panel panel-for="libcluster-config">
          <.dm_card variant="bordered" class="bg-surface-container" body_class="space-y-4">
            <:title>
              <div class="flex items-center gap-2">
                <.dm_mdi name="cog-transfer" class="h-5 w-5 text-primary" />
                <span class="text-lg font-semibold">Libcluster Configuration</span>
              </div>
            </:title>

            <.dm_form
              for={@cluster_form}
              action={~p"/node_management"}
              method="post"
              class="flex flex-col gap-4"
            >
              <input type="hidden" name="action" value="configure-cluster" />

              <.dm_switch
                field={@cluster_form[:enabled]}
                label="Enable libcluster"
              />

              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <.dm_select
                  field={@cluster_form[:strategy]}
                  label="Strategy"
                  options={@cluster_strategy_options}
                />
                <.dm_input
                  field={@cluster_form[:topology_name]}
                  type="text"
                  label="Topology"
                  placeholder="gsmlg"
                />
              </div>

              <.dm_textarea
                field={@cluster_form[:hosts]}
                label="EPMD hosts"
                rows={5}
                placeholder="gsmlg@10.100.10.10\ngsmlg@10.100.10.11"
              />

              <.dm_input
                field={@cluster_form[:connect_interval]}
                type="number"
                label="Reconnect interval"
                min="1000"
                step="1000"
              />

              <div class="rounded-lg border border-outline-variant bg-surface-container-high p-3">
                <p class="mb-3 text-sm font-semibold">Gossip options</p>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                  <.dm_input
                    field={@cluster_form[:gossip_port]}
                    type="number"
                    label="Port"
                    min="1"
                    max="65535"
                  />
                  <.dm_input
                    field={@cluster_form[:gossip_if_addr]}
                    type="text"
                    label="Interface"
                    placeholder="0.0.0.0"
                  />
                  <.dm_input
                    field={@cluster_form[:gossip_multicast_addr]}
                    type="text"
                    label="Multicast address"
                    placeholder="233.252.1.32"
                  />
                  <.dm_input
                    field={@cluster_form[:gossip_multicast_ttl]}
                    type="number"
                    label="TTL"
                    min="1"
                  />
                </div>
                <div class="mt-3 flex flex-col gap-3">
                  <.dm_input
                    field={@cluster_form[:gossip_secret]}
                    type="password"
                    label="Secret"
                    autocomplete="off"
                  />
                  <.dm_switch
                    field={@cluster_form[:gossip_broadcast_only]}
                    label="Broadcast only"
                  />
                </div>
              </div>

              <:actions>
                <.dm_btn type="submit" variant="primary" class="w-full">
                  <:prefix><.dm_mdi name="content-save" class="h-4 w-4" /></:prefix>
                  Apply Cluster Configuration
                </.dm_btn>
              </:actions>
            </.dm_form>
          </.dm_card>
        </el-dm-tab-panel>
      </el-dm-tabs>
    </div>
  </div>
</Layouts.app>
