<Layouts.auth flash={@flash}>
  <div class="flex flex-col gap-6">
    <%!-- Header --%>
    <div class="space-y-1">
      <p class="font-mono text-[10px] tracking-[0.35em] uppercase text-primary opacity-60">
        NEW ACCOUNT
      </p>
      <h2 class="font-mono text-2xl font-bold text-base-content">
        Sign up
      </h2>
      <p class="text-sm text-base-content opacity-40">
        Register to request admin access.
      </p>
    </div>

    <%!-- Form --%>
    <.dm_form
      :let={f}
      for={@changeset}
      id="user-form"
      action={~p"/sign_up"}
      class="flex flex-col gap-4 w-full"
    >
      <.dm_input field={f[:email]} type="text" label="Email" variant="bordered" class="w-full" />
      <.dm_input field={f[:username]} type="text" label="Username" variant="bordered" class="w-full" />
      <.dm_input field={f[:password]} type="password" label="Password" variant="bordered" class="w-full" />
      <:actions>
        <.dm_btn type="submit" variant="primary" class="w-full mt-1">
          Create account →
        </.dm_btn>
      </:actions>
    </.dm_form>

    <%!-- Divider + sign-in link --%>
    <.dm_divider>OR</.dm_divider>

    <.link
      class="btn btn-ghost w-full border border-base-300 font-mono text-xs tracking-wider"
      navigate={~p"/sign_in"}
    >
      Back to sign in
    </.link>
  </div>
</Layouts.auth>
