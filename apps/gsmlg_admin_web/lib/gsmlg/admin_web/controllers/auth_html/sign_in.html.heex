<Layouts.auth flash={@flash}>
  <div class="flex flex-col gap-8 si-panel">
    <%!-- Header --%>
    <div class="si-header">
      <p class="si-eyebrow">⬡ SYSTEM AUTHENTICATION</p>
      <h2 class="si-title">
        Sign in<span class="si-cursor" aria-hidden="true"></span>
      </h2>
      <p class="si-subtitle">Credentials required to proceed.</p>
    </div>

    <%!-- Form --%>
    <.form
      :let={f}
      for={@changeset}
      action={~p"/sign_in"}
      class="flex flex-col gap-5"
    >
      <%!-- Username --%>
      <div class="si-field">
        <label for={f[:username].id} class="si-label">USERNAME</label>
        <div class="si-input-wrap">
          <span class="si-prompt" aria-hidden="true">›</span>
          <input
            id={f[:username].id}
            type="text"
            name={f[:username].name}
            value={f[:username].value || ""}
            class="si-input"
            autocomplete="username"
            autofocus
          />
        </div>
        <%= for {msg, _} <- f[:username].errors do %>
          <p class="si-err">{msg}</p>
        <% end %>
      </div>

      <%!-- Password --%>
      <div class="si-field">
        <label for={f[:password].id} class="si-label">PASSWORD</label>
        <div class="si-input-wrap">
          <span class="si-prompt" aria-hidden="true">›</span>
          <input
            id={f[:password].id}
            type="password"
            name={f[:password].name}
            class="si-input"
            autocomplete="current-password"
          />
        </div>
        <%= for {msg, _} <- f[:password].errors do %>
          <p class="si-err">{msg}</p>
        <% end %>
      </div>

      <%!-- Submit --%>
      <button type="submit" class="si-btn">
        <span class="si-btn-label">AUTHENTICATE</span>
        <span class="si-btn-arrow" aria-hidden="true">→</span>
        <span class="si-btn-shimmer" aria-hidden="true"></span>
      </button>
    </.form>

    <%!-- Divider --%>
    <div class="si-divider">
      <div class="si-divider-line"></div>
      <span class="si-divider-text">OR</span>
      <div class="si-divider-line"></div>
    </div>

    <a href={~p"/sign_up"} class="si-alt-btn">
      Create an account
    </a>
  </div>
</Layouts.auth>
