<div class="flex flex-col">
  <h3 class="text-3xl text-center text-primary">Sign up</h3>
  <.dm_form
    :let={f}
    for={@changeset}
    id="user-form"
    method={:post}
    phx-change="validate"
    phx-submit="save"
  >
    <input name="_csrf_token" type="hidden" value={get_csrf_token()} />
    <.dm_input field={f[:email]} type="text" label="Email" />
    <.dm_input field={f[:username]} type="text" label="Username" />
    <.dm_input field={f[:password]} type="password" label="Password" />
    <:actions>
      <button class="btn btn-primary btn-block" phx-disable-with="Saving...">Sign up</button>
    </:actions>
  </.dm_form>

  <div class="divider">OR</div>

  <.link class="btn btn-info btn-block" navigate={~p"/sign_in"}>
    Sign in
  </.link>
</div>
