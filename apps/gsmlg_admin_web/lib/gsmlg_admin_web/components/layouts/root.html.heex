<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="oklch(95.86% 0.0693 95.91)"
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="oklch(85.45% 0 0)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · GSMLG BITW">
      {assigns[:page_title] || "GSMLG BITW"}
    </.live_title>
    <script async type="module" src="https://esm-run.gsmlg.dev/@gsmlg/lit">
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script type="module">
      document.querySelector('meta[name=theme-color]').setAttribute('content', getComputedStyle(document.body).getPropertyValue('--color-primary'));
    </script>
    <script defer phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content antialiased flex flex-col overflow-x-hidden w-svw min-h-screen">
    {@inner_content}
  </body>
</html>
