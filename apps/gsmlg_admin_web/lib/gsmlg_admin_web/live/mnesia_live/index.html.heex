<h3 class="mx-4 my-2 text-3xl text-blue-400 font-bold"><%= @page_title %></h3>
<div class="container">
  <.dm_card>
    <:title class="flex flex-row justify-center">
      <h3 class="font-semibold text-2xl">Mnesia Database Info</h3>
    </:title>

    <div class="mx-4 my-2 flex flex-col w-full">
      <%= if is_list(@info) do %>
        <ul class="flex flex-col">
          <li :for={{k, v} <- @info} data-key={k} class="flex gap-4">
            <label class="text-teal-400 basis-1/3 text-right after:content-[':']"><%= k %></label>
            <label class="text-slate-800"><%= inspect(v) %></label>
          </li>
        </ul>
      <% end %>
    </div>
  </.dm_card>
  <.dm_card>
    <:title class="flex flex-row justify-center">
      <h3 class="font-semibold text-2xl">Tables</h3>
    </:title>

    <div class="mx-4 my-2 flex flex-col w-full gap-4">
      <%= if is_list(@tables_info) do %>
        <div :for={{name, info} <- @tables_info} data-key={name} class="flex flex-col gap-2">
          <h4 class={[
            "flex flex-row justify-center",
            "font-semibold text-xl"
          ]}>
            <%= name %>
          </h4>
          <ul class="flex flex-col">
            <%= if is_list(info) do %>
              <li :for={{key, v} <- info} data-key={key} class="flex gap-4">
                <label class="text-teal-400 basis-1/3 text-right after:content-[':']">
                  <%= key %>
                </label>
                <label class="text-slate-800"><%= inspect(v) %></label>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </.dm_card>
</div>
