
<div class="container flex flex-col gap-2 mt-4 w-full">
  <div class="mx-4 my-2 flex flex-row justify-end">
    <.link
      class="btn btn-sm btn-primary"
      navigate={~p"/users/new"}
    >
      Add User
    </.link>
  </div>
  <.dm_table data={@users}>
    <:col :let={u} label="Email">
      <%= u.email %>
    </:col>
    <:col :let={u} label="Username">
      <%= u.username %>
    </:col>
    <:col :let={u} label="Name">
      <%= u.name %>
    </:col>
    <:col :let={u} label="Active">
      <%= u.is_active %>
    </:col>
    <:col :let={u} label="Enable 2FA">
      <%= u.is_2fa_enabled %>
    </:col>

    <:col :let={u} label="">
      <div class="flex gap-2">
        <.link
          class="btn btn-sm btn-info"
          navigate={~p"/users/#{u.id}"}
        >
          Show
        </.link>
        <.link
          class="btn btn-sm btn-warning"
          navigate={~p"/users/#{u.id}/edit"}
        >
          Edit
        </.link>
        <.link
          class="btn btn-sm btn-error"
          phx-click={JS.push("delete", value: %{id: u.id})}
          data-confirm="Are you sure?"
        >
          Delete
        </.link>
      </div>
    </:col>
  </.dm_table>
</div>
