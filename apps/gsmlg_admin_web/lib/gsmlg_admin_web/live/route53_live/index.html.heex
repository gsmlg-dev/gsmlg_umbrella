<.dm_async_card
  :let={hosted_zones}
  :if={@live_action == :list_zones}
  assign={@hosted_zones}
  class="section-card"
  skeleton_class="min-h-48"
>
  <:title class="flex flex-row">
    <h3 class="font-semibold text-2xl">Hosted Zones</h3>
  </:title>

  <.dm_table data={hosted_zones.list}>
    <:col :let={zone} label="Id">
      {Map.get(zone, "Id")}
    </:col>
    <:col :let={zone} label="Name">
      {Map.get(zone, "Name")}
    </:col>
    <:col :let={zone} label="Record Count">
      {Map.get(zone, "ResourceRecordSetCount")}
    </:col>
    <:col :let={zone} label="Comment">
      {get_in(zone, ["Config", "Comment"])}
    </:col>

    <:col :let={zone} label="">
      <div class="flex gap-2">
        <.link
          class="btn btn-sm btn-info"
          patch={
            ~p"/aws/route53/hosted_zones/#{case Map.get(zone, "Id") do
              "/hostedzone/" <> id -> id
              id -> id
            end}/records"
          }
        >
          List Records
        </.link>
      </div>
    </:col>
  </.dm_table>

  <div :if={!is_nil(hosted_zones.next_token)}>
    <div class="flex gap-2">
      <button
        class="btn btn-sm btn-block	btn-primary"
        phx-click={
          JS.push("next_token", value: %{"next_zones" => Tuple.to_list(hosted_zones.next_token)})
        }
      >
        Next
      </button>
    </div>
  </div>
</.dm_async_card>

<.dm_async_card
  :let={resource_record_sets}
  :if={@live_action == :list_records}
  assign={@resource_record_sets}
  class="section-card"
  skeleton_class="min-h-48"
>
  <:title class="flex flex-row items-center">
    <.link class="btn btn-square btn-sm btn-primary" patch={~p"/aws/route53/hosted_zones"}>
      <.dm_mdi name="chevron-double-left" class="w-6 h-6" />
    </.link>
    <h3 class="w-full font-semibold text-2xl">Resource Record Sets</h3>
    <.dm_modal class="modal-backdrop">
      <:trigger :let={f}>
        <button
          class="btn btn-circle btn-primary btn-sm"
          onclick={"document.getElementById('#{f}').showModal()"}
        ><.dm_mdi name="plus" class="w-6 h-6" /></button>
      </:trigger>
      <:title>Add Resource Record</:title>
      <:body>
        <.dm_form :let={f} method="dialog" class="w-96">
          <.dm_input field={f[:name]} label="Name" />
          <.dm_input field={f[:ttl]} label="TTL" type="number" min={0} max={65535} />
          <.dm_input field={f[:type]} label="Type" type="select" 
            options={[
              "A",
              "AAAA",
              "CAA",
              "CNAME",
              "DS",
              "HTTPS",
              "MX",
              "NAPTR",
              "NS",
              "PTR",
              "SOA",
              "SPF",
              "SRV",
              "SSHFP",
              "SVCB",
              "TLSA",
              "TXT",
            ]}
          />
          <.dm_input field={f[:rdata]} label="RData" type="textarea" />
          <div class="flex justify-end items-center gap-4 mt-4">
            <button class="btn btn-sm btn-neutral">Close</button>
            <button class="btn btn-sm btn-primary" type="submit">Save</button>
          </div>
        </.dm_form>
      </:body>
    </.dm_modal>
  </:title>
  <.dm_table data={resource_record_sets |> Map.get(@hosted_zone_id, %{}) |> Map.get(:list, [])}>
    <:col :let={rr} label="Name">
      <span class="inline-block break-all">{Map.get(rr, "Name")}</span>
    </:col>
    <:col :let={rr} label="TTL">
      {Map.get(rr, "TTL")}
    </:col>
    <:col :let={rr} label="Type">
      {Map.get(rr, "Type")}
    </:col>
    <:col :let={rr} label="RData">
      {case get_in(rr, ["ResourceRecords", "ResourceRecord"]) do
        %{"Value" => value} ->
          {:safe, ~s(<div class="break-all">#{value}</div>)}

        list when is_list(list) ->
          {:safe,
           ~s(<div class="flex flex-col gap-2">#{list |> Enum.map(&Map.get(&1, "Value")) |> Enum.map(fn n -> ~s(<div class="break-all bg-base-200 p-2 rounded w-fit">#{n}</div>) end)}</div>)}
      end}
    </:col>

    <:col :let={rr} label="">
      <div class="flex gap-2">
        <button
          class="btn btn-sm btn-primary"
          phx-click={JS.push("edit_record", value: %{"record" => rr})}
        >
          Edit
        </button>
        <.dm_btn
          id={"id-del-#{Map.get(rr, "Name")}$#{Map.get(rr, "Type")}"}
          confirm={dgettext("aws.route53", "Do you want to remove this RRset (%{name} %{type})?", %{name: Map.get(rr, "Name"), type: Map.get(rr, "Type")})}
          class="btn-sm btn-error"
          confirm_class="btn-error btn-sm"
          cancel_class="btn-ghost btn-sm"
          confirm_title="Attention!"
        >
          Delete
          <:confirm_action>
            <form method="dialog">
              <.dm_btn class="btn-error btn-sm">Delete</.dm_btn>
            </form>
          </:confirm_action>
        </.dm_btn>
      </div>
    </:col>
  </.dm_table>

  <% next_token = resource_record_sets |> Map.get(@hosted_zone_id, %{}) |> Map.get(:next_token) %>
  <div :if={!is_nil(next_token)}>
    <div class="flex gap-2">
      <button
        class="btn btn-sm btn-block	btn-primary"
        phx-click={
          JS.push("next_token",
            value: %{"next_records" => Tuple.to_list(next_token)}
          )
        }
      >
        Next
      </button>
    </div>
  </div>
</.dm_async_card>
