<h3 class="mx-4 my-2 text-3xl text-blue-600"><%= @page_title %></h3>

<div class="mx-4 my-2 flex gap-2">
  <.link
    class="rounded-lg bg-green-600 hover:bg-green-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80"
    navigate={~p"/blogs"}
  >
    All Blog List
  </.link>
  <%= if !is_nil(@blog.id) do %>
    <.link
      class="rounded-lg bg-green-600 hover:bg-green-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80"
      navigate={~p"/blogs/#{@blog.id}"}
    >
      Show Blog
    </.link>
  <% end %>
</div>

<div class="mx-4 my-2">
  <.simple_form
    :let={f}
    for={@changeset}
    id="blog-form"
    method={:post}
    phx-change="validate"
    phx-submit="save"
  >
    <.input field={{f, :slug}} type="text" label="Slug" />
    <.input field={{f, :title}} type="text" label="Title" />
    <.input field={{f, :author}} type="text" label="Author" />
    <.input field={{f, :date}} type="date" label="Date" />
    <.input field={{f, :content}} type="textarea" label="Content" rows="24" />
    <div>
      <span
        class="cursor-pointer rounded-lg bg-green-600 hover:bg-green-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80"
        onclick="document.querySelector('remark-element').update();"
      >
        Preview
      </span>
      <remark-element id="blog-form_content-preview">
        <%= Phoenix.HTML.Form.input_value(f, :content) %>
      </remark-element>
    </div>
    <:actions>
      <.button class="" phx-disable-with="Saving...">Save</.button>
    </:actions>
  </.simple_form>
</div>
