<h3 class="mx-4 my-2 text-3xl text-blue-600"><%= @page_title %></h3>

<div class="mx-4 my-2 flex gap-2">
    <.link class="rounded-lg bg-green-600 hover:bg-green-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80" navigate={~p"/blogs"}>
        All Blog List
    </.link>
</div>

<div class="mx-4 my-2">
  <.simple_form
      :let={f}
      for={@changeset}
      id="import-blog-form"
      method={:post}
      phx-change="validate"
      phx-submit="save"
  >
    <.input field={{f, :data}} type="textarea" label="JSON Data" rows="12" />
    <:actions>
        <.button class="" phx-disable-with="Importing...">Import</.button>
    </:actions>
  </.simple_form>
</div>
