<div :if={@live_action == :import} class="container flex flex-col gap-2 mt-4 w-full">
  <div class="mx-4 my-2 flex gap-2">
    <.link class="btn btn-sm btn-primary" navigate={~p"/blogs"}>
      All Blog List
    </.link>
  </div>

  <div class="mx-4 my-2">
    <.dm_form
      :let={f}
      for={@changeset}
      id="import-blog-form"
      method={:post}
      phx-change="validate"
      phx-submit="save"
    >
      <.dm_input field={f[:data]} type="textarea" label="JSON Data" rows="12" />
      <:actions>
        <button class="btn btn-sm btn-primary" phx-disable-with="Importing...">Import</button>
      </:actions>
    </.dm_form>
  </div>
</div>
