<!DOCTYPE html>
<html lang="en" data-theme="sunshine">
  <head>
    <script>
      (function(){
        var t = localStorage.getItem("theme");
        if (!t || t === "default") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "moonlight" : "sunshine";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <meta charset="utf-8" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="oklch(95.86% 0.0693 95.91)"
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="oklch(85.45% 0 0)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix="">
      {assigns[:page_title] || gettext("default page title")}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script type="module">
      document.querySelector('meta[name=theme-color]').setAttribute('content', getComputedStyle(document.body).getPropertyValue('--color-primary'));
    </script>
    <script defer phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
    <%= if (Application.get_env(:gsmlg_web, GSMLG.Web.Endpoint) || []) |> Keyword.get(:enable_adsense) == true do %>
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2900591828353755"
        crossorigin="anonymous"
      >
      </script>
    <% end %>
  </head>
  <body class={[
    "flex flex-col",
    "text-on-surface bg-surface",
    "overflow-x-hidden antialiased"
  ]}>
    {@inner_content}
    <.footer locale={assigns[:current_locale] || GSMLG.Locale.default()} />
  </body>
</html>
