<!DOCTYPE html>
<html lang="en" data-theme="sunshine">
  <head>
    <meta charset="utf-8" />
    <meta
      name="theme-color"
      content={theme_colors().sunshine}
      data-sunshine={theme_colors().sunshine}
      data-moonlight={theme_colors().moonlight}
    />
    <script>
      (function(){
        var t = localStorage.getItem("theme");
        if (!t || t === "default") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "moonlight" : "sunshine";
        }
        document.documentElement.setAttribute("data-theme", t);
        var color = document.querySelector('meta[name="theme-color"]');
        color.content = color.getAttribute("data-" + t) || color.content;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix="">
      {assigns[:page_title] || gettext("default page title")}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={
        DuskmoonBundler.static_path(GSMLG.Web.Endpoint, "/assets/css/app.css",
          profile: :gsmlg_web
        )
      }
    />
    <script
      defer
      phx-track-static
      type="module"
      src={
        DuskmoonBundler.static_path(GSMLG.Web.Endpoint, "/assets/js/app.js", profile: :gsmlg_web)
      }
    >
    </script>
    <%= if (Application.get_env(:gsmlg_web, GSMLG.Web.Endpoint) || []) |> Keyword.get(:enable_adsense) == true do %>
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2900591828353755"
        crossorigin="anonymous"
      >
      </script>
    <% end %>
  </head>
  <body class={[
    "flex flex-col",
    "text-on-surface bg-surface",
    "overflow-x-hidden antialiased"
  ]}>
    {@inner_content}
    <.footer locale={assigns[:current_locale] || GSMLG.Locale.default()} />
  </body>
</html>
