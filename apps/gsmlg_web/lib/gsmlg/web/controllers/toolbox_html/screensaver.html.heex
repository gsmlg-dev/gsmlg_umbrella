<Layouts.app flash={@flash}>
  <:header_slot>
    <div class="header-hero-container">
      <h1 class="header-hero-text">
        {@title}
      </h1>
    </div>
  </:header_slot>
  <div class="flex flex-col container px-8 gap-6">
    <div class="flex flex-col justify-center items-center gap-4 p-4">
      <div class="w-full h-full min-h-96 flex justify-center">
        <canvas id="screen-saver-canvas" class="w-full h-full min-h-96 rounded-lg" />
        <video id="screen-saver-video" class="hidden w-full h-full min-h-96" controls></video>
      </div>
      <.dm_btn id="screen-saver-trigger" class="btn-primary">
        {dgettext("toolbox", "start-fullscreen")}
      </.dm_btn>
      <script type="module" src={~p"/assets/tools/screensaver.js"}>
      </script>
    </div>
  </div>
</Layouts.app>
