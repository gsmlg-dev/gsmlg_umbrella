<Layouts.app flash={@flash}>
  <:header_slot>
    <div class="header-hero-container">
      <h1 class="header-hero-text">
        {@title}
      </h1>
    </div>
  </:header_slot>
  <div class="flex flex-col container px-8 gap-6">
    <div class="flex justify-center items-center">
      <form
        id="whois-form"
        class="flex flex-col justify-center items-center gap-4 w-84 my-4"
      >
        <div class="flex w-full gap-2">
          <label class="flex items-center gap-1 cursor-pointer">
            <input
              type="radio"
              name="protocol"
              value="whois"
              checked
              class="radio radio-primary radio-sm"
            />
            <span class="text-sm">{dgettext("toolbox", "WHOIS")}</span>
          </label>
          <label class="flex items-center gap-1 cursor-pointer">
            <input type="radio" name="protocol" value="rdap" class="radio radio-primary radio-sm" />
            <span class="text-sm">{dgettext("toolbox", "RDAP")}</span>
          </label>
        </div>
        <.dm_compact_input
          id="whois-input"
          class="w-full input-primary"
          name="look_for"
          value=""
          label={dgettext("toolbox", "Domain / IP / ASN")}
        />
        <.dm_btn id="whois-submit" class="btn-primary btn-block" type="submit">
          {dgettext("toolbox", "Lookup")}
        </.dm_btn>
      </form>
    </div>

    <div id="whois-result" class="flex flex-col justify-center items-start gap-4 w-full"></div>
  </div>

  <script type="module" src={~p"/assets/tools/whois.js"}>
  </script>
</Layouts.app>
