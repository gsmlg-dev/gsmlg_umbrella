<div class="hero min-h-screen bg-base-200">
  <div class="hero-content flex-col lg:flex-row-reverse">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">{dgettext("user", "Magic Link Login")}</h1>
      <p class="py-6">
        {dgettext(
          "user",
          "Enter your email address and we'll send you a magic link to sign in instantly. No passwords required!"
        )}
      </p>
      <div class="alert alert-info">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="stroke-current shrink-0 w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          >
          </path>
        </svg>
        <span>
          {dgettext("user", "Your link will expire in 24 hours and can only be used once.")}
        </span>
      </div>
    </div>

    <div class="card shrink-0 w-full max-w-sm shadow-2xl bg-base-100">
      <form class="card-body" action={~p"/auth/magic-link"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

        <%= if @error do %>
          <div class="alert alert-error">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>{@error}</span>
          </div>
        <% end %>

        <div class="form-control">
          <label class="label" for="email">
            <span class="label-text">{dgettext("user", "Email")}</span>
          </label>
          <input
            type="email"
            name="email"
            id="email"
            value={@email}
            required
            placeholder="you@example.com"
            class="input input-bordered"
          />
        </div>

        <div class="form-control mt-6">
          <button type="submit" class="btn btn-primary">
            {dgettext("user", "Send Magic Link")}
          </button>
        </div>

        <div class="divider">{gettext("OR")}</div>

        <div class="form-control">
          <a href={~p"/auth/github"} class="btn btn-outline btn-wide">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="ml-2">{dgettext("user", "Continue with GitHub")}</span>
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Theme Switcher Component -->
<GSMLG.Web.Components.ThemeSwitcher.theme_switcher themes={@themes || []} />
