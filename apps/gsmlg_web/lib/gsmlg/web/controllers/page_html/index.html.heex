<Layouts.app flash={@flash}>
  <:header_slot>
    <section class={[
      "w-full h-64",
      "font-bold select-none drop-shadow-md text-shadow-lg",
      "flex flex-col items-center justify-evenly"
    ]}>
      <h2 class="header-hero-text uppercase">
        {dgettext("homepage", "slogan-1")}
      </h2>
      <h2 class="header-hero-text uppercase">
        {dgettext("homepage", "slogan-2")}
      </h2>
    </section>
  </:header_slot>
  <section :for={{group, repos} <- @group_repos} class="container flex flex-col my-12">
    <h3 class="flex justify-center gap-4 flex-wrap text-4xl my-24">
      <code class="text-info">{group}</code>
      <span class="text-neutral-content">{dgettext("github", "Github Repos")}</span>
    </h3>
    <div class="grid grid-cols-auto-fill-96 gap-4 px-4">
      <.github_repo_card :for={repo <- repos} repo={repo} />
    </div>
  </section>
</Layouts.app>
