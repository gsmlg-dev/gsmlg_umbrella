<div>
  <ui5-title level="H1"><%= @page_title %></ui5-title>

  <div class="header">
  <%= if !is_nil(@user.id) do %>
  <span><%= bx_live_redirect "Show", to: Routes.user_show_path(@socket, :show, @user) %></span> |
  <% end %>
  <span><%= bx_live_redirect "Back", to: Routes.user_index_path(@socket, :index) %></span>
  </div>

  <.form let={f} for={@changeset} phx-change="validate" phx-submit="save">
    <div class="form-group">
    <%= bx_label f, :username %>
    <%= bx_text_input f, :username %>

    </div>
    <div class="form-group">
    <%= bx_label f, :name %>
    <%= bx_text_input f, :name %>

    </div>
    <div class="form-group">
    <%= bx_label f, :email %>
    <%= bx_text_input f, :email %>
    </div>

    <div class="form-group">
    <%= bx_label f, :password %>
    <%= bx_password_input f, :password %>
    </div>

    <div class="form-group">
      <%= bx_submit "Save", phx_disable_with: "Saving..." %>
      <%= submit "Save", phx_disable_with: "Saving..." %>
    </div>
  </.form>
</div>
