<h1>Show User</h1>

<%= if @live_action in [:edit] do %>
  <.modal return_to={Routes.user_show_path(@socket, :show, @user)}>
    <.live_component
      module={GSMLGWeb.UserLive.FormComponent}
      id={@user.id}
      title={@page_title}
      action={@live_action}
      user={@user}
      return_to={Routes.user_show_path(@socket, :show, @user)}
    />
  </.modal>
<% end %>

<ul>

  <li>
    <strong>Name:</strong>
    <%= @user.name %>
  </li>

  <li>
    <strong>Email:</strong>
    <%= @user.email %>
  </li>

  <li>
    <strong>Password:</strong>
    <%= @user.password %>
  </li>

  <li>
    <strong>Password salt:</strong>
    <%= @user.password_salt %>
  </li>

  <li>
    <strong>Is active:</strong>
    <%= @user.is_active %>
  </li>

  <li>
    <strong>Otp token:</strong>
    <%= @user.otp_token %>
  </li>

  <li>
    <strong>Verify code:</strong>
    <%= @user.verify_code %>
  </li>

  <li>
    <strong>Portrait:</strong>
    <%= @user.portrait %>
  </li>

  <li>
    <strong>Google:</strong>
    <%= @user.google_id %>
  </li>

  <li>
    <strong>Apple:</strong>
    <%= @user.apple_id %>
  </li>

  <li>
    <strong>Github:</strong>
    <%= @user.github_id %>
  </li>

  <li>
    <strong>Active time:</strong>
    <%= @user.active_time %>
  </li>

</ul>

<span><%= live_patch "Edit", to: Routes.user_show_path(@socket, :edit, @user), class: "button" %></span> |
<span><%= live_redirect "Back", to: Routes.user_index_path(@socket, :index) %></span>
