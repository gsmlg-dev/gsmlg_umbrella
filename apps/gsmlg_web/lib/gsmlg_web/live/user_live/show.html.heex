<div class="h1">Show User</div>

<div class="header">
  <span><%= wc_live_redirect "Edit", to: Routes.user_modify_path(@socket, :edit, @user), kind: "primary" %></span> |
  <span><%= wc_live_redirect "Back", to: Routes.user_index_path(@socket, :index), kind: "ghost" %></span>
</div>

<div class="show-info">
  <bx-structured-list>
    <bx-structured-list-head>
      <bx-structured-list-header-row>
        <bx-structured-list-header-cell>Label</bx-structured-list-header-cell>
        <bx-structured-list-header-cell>Value</bx-structured-list-header-cell>
      </bx-structured-list-header-row>
    </bx-structured-list-head>
    <bx-structured-list-body>
      <%= for {l, v} <-  @user |> Map.from_struct() |> Map.drop([:__meta__, :tokens]) do %>
      <bx-structured-list-row>
        <bx-structured-list-cell><%= l %></bx-structured-list-cell>
        <bx-structured-list-cell><%= v %></bx-structured-list-cell>
      </bx-structured-list-row>
      <% end %>
    </bx-structured-list-body>
  </bx-structured-list>
</div>
