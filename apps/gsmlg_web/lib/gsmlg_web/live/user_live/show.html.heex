<ui5-title level="H1">Show User</ui5-title>


<span><%= bx_live_redirect "Edit", to: Routes.user_modify_path(@socket, :edit, @user), kind: "primary" %></span> |
<span><%= bx_live_redirect "Back", to: Routes.user_index_path(@socket, :index), kind: "ghost" %></span>

<div class="show-info">
  <div class="show-field">
    <ui5-label class="label">
      <strong>Username:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.username %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Name:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.name %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Email:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.email %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Is Active:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.is_active %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Portrait:</strong>
    </ui5-label>
    <ui5-label>
    <%= @user.portrait %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
    <strong>Google:</strong>
    </ui5-label>
    <ui5-label>
    <%= @user.google_id %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Apple:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.apple_id %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Github:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.github_id %>
    </ui5-label>
  </div>
  <div class="show-field">
    <ui5-label class="label">
      <strong>Active Time:</strong>
    </ui5-label>
    <ui5-label>
      <%= @user.active_time %>
    </ui5-label>
  </div>
</div>
