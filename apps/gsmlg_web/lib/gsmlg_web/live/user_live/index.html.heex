<div class="h1">Listing Users</div>

<section class="content-table">
  <%= wc_table(@users, [
    columns: [name: "Name", username: "Username", email: "email", is_active: "Is Active", portrait: "Portrait", google_id: "Google ID", apple_id: "Apple ID", github_id: "Github ID", active_time: "Active Time", actions__: ""],
    content_columns: [:name, :actions__],
    content_functions: [
      fn(b) ->
        wc_live_redirect "#{b.name}", to: Routes.user_show_path(@socket, :show, b)
      end,
      fn(b) ->
        [
          content_tag(:span, wc_live_redirect("Edit", to: Routes.user_modify_path(@socket, :edit, b))),
          content_tag(:span, wc_link("Delete", to: "#", phx_click: "delete", phx_value_id: b.id, data: [confirm: "Are you sure?"]))
        ]
      end
    ],
    toolbar_actions: [
      wc_live_redirect("Add User", to: Routes.user_modify_path(@socket, :new))
    ]
  ]) %>
</section>
