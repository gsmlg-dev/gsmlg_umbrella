<div>
  <ui5-title level="H1"><%= @page_title %></ui5-title>

  <div class="header">
  <%= if !is_nil(@blog.id) do %>
  <span><%= bx_live_redirect "Show", to: Routes.blog_show_path(@socket, :show, @blog) %></span> |
  <% end %>
  <span><%= bx_live_redirect "Back", to: Routes.blog_index_path(@socket, :index) %></span>
  </div>

  <.form let={f} for={@changeset} phx-change="validate" phx-submit="save">
    <div class="form-group">
    <%= bx_label f, :slug %>
    <%= bx_text_input f, :slug %>
    <%= error_tag f, :slug %>
    </div>
    <div class="form-group">
    <%= bx_label f, :title %>
    <%= bx_text_input f, :title %>
    <%= error_tag f, :title %>
    </div>
    <div class="form-group">
    <%= bx_label f, :date %>
    <%= bx_date_select f, :date, format_pattern: "yyyy-MM-dd" %>
    <%= error_tag f, :date %>
    </div>
    <div class="form-group">
    <%= bx_label f, :author %>
    <%= bx_text_input f, :author %>
    <%= error_tag f, :author %>
    </div>
    <div class="form-group">
      <%= bx_label f, :content %>
      <div>
        <%= bx_textarea f, :content, [rows: 50] %>
        <%= error_tag f, :content %>
      </div>
      <div>
        <remark-element id="content-preview"></remark-element>
      </div>
      <script>
        (() => {
          const ipt = document.getElementById('blog_content');
          const pre = document.getElementById('content-preview');
          const sync = () => {
            pre.innerHTML = ipt.value;
            pre.requestUpdate();
          };
          ipt.addEventListener('input', sync);
          setTimeout(sync, 1000);
        })()
      </script>
    </div>
    <div class="form-group">
      <%= bx_submit "Save", phx_disable_with: "Saving..." %>
      <%= submit "Save", phx_disable_with: "Saving..." %>
    </div>
  </.form>
</div>
