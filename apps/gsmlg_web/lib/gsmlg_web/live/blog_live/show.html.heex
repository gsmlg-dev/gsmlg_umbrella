<ui5-title level="H1">Show Blog</ui5-title>

<div class="header">
<span><%= wc_live_redirect "Edit", to: Routes.blog_modify_path(@socket, :edit, @blog) %></span> |
<span><%= wc_live_redirect "Back", to: Routes.blog_index_path(@socket, :index) %></span>
</div>

<ul>
  <li>
    <strong>Slug:</strong>
    <%= @blog.slug %>
  </li>

  <li>
    <strong>Title:</strong>
    <%= @blog.title %>
  </li>

  <li>
    <strong>Date:</strong>
    <%= @blog.date %>
  </li>

  <li>
    <strong>Author:</strong>
    <%= @blog.author %>
  </li>

  <li>
    <strong>Content:</strong>
    <br/>
    <hr />
    <remark-element>
<%= @blog.content |> raw %>
    </remark-element>
  </li>

</ul>
