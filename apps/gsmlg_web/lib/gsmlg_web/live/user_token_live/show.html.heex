
<h3 class="mx-4 my-2 text-3xl text-blue-600"><%= @page_title %></h3>

<div class="mx-4 my-2 flex gap-2">
    <.link class="rounded-lg bg-green-600 hover:bg-green-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80" navigate={~p"/admin/user_tokens"}>
        All User Token List
    </.link>

    <.link class="rounded-lg bg-blue-600 hover:bg-blue-400 py-2 px-3 text-sm font-semibold leading-6 text-center text-white active:text-white/80" navigate={~p"/admin/user_tokens/#{@user_token.jti}/edit"}>
        Edit User Token
    </.link>
</div>

<div class="mx-8 my-2">
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            aud
        </div>
        <div class="flex-1">
            <%= Map.get(@user_token, :aud) %>
        </div>
    </div>
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            claims
        </div>
        <div class="flex-1">
            <json-viewer indent="2">
            <%= Map.get(@user_token, :claims) |> Jason.encode!() %>
            </json-viewer>
        </div>
    </div>
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            exp
        </div>
        <div class="flex-1">
            <%= Map.get(@user_token, :exp) |> DateTime.from_unix!() |> DateTime.to_iso8601() %>
        </div>
    </div>
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            nbf
        </div>
        <div class="flex-1">
            <%= Map.get(@user_token, :claims) |> Map.get("nbf") |> DateTime.from_unix!() |> DateTime.to_iso8601() %>
        </div>
    </div>
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            iss
        </div>
        <div class="flex-1">
            <%= Map.get(@user_token, :iss) %>
        </div>
    </div>
    <div class="flex flex-row">
        <div class="flex-1 text-blue-400">
            jwt
        </div>
        <div class="flex-1">
            <jwt-viewer token={Map.get(@user_token, :jwt)} />
        </div>
    </div>
</div>
