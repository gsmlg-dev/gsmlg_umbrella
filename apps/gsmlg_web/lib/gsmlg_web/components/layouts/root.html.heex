<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="oklch(95.86% 0.0693 95.91)"
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="oklch(85.45% 0 0)" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix="">
      {assigns[:page_title] || gettext("default page title")}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <%= if Application.get_env(:gsmlg_web, GSMLGWeb.Endpoint) |> Keyword.get(:enable_adsense) |> Kernel.==("yes") do %>
      <script
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2900591828353755"
        crossorigin="anonymous"
      >
      </script>
    <% end %>
  </head>
  <body class={[
    "flex flex-col",
    "text-base-content bg-base-200",
    "overflow-x-hidden antialiased"
  ]}>
    {@inner_content}
    <.dm_page_footer class={[
      "bg-gradient-to-tl from-secondary to-accent",
      "text-neutral"
    ]}>
      <:section title="Site Map">
        <.link href={~p"/"}>{dgettext("menu", "Home")}</.link>
        <.link href={~p"/blogs"}>{dgettext("menu", "Blog")}</.link>
        <.link href={~p"/toolbox"}>{dgettext("menu", "Toolbox")}</.link>
      </:section>

      <:section title="Toolbox">
        <.link href="/toolbox/geoip2">{dgettext("menu", "GeoIP2 Database")}</.link>
        <.link href="/toolbox/whois">{dgettext("menu", "Domain/IP/ASN Whois")}</.link>
        <.link href="/toolbox/svg2react">{dgettext("menu", "SVG to React")}</.link>
        <.link href="/toolbox/svg_autocrop">{dgettext("menu", "SVG AutoCrop")}</.link>
        <.link href="/toolbox/mac_manufacturer">
          {dgettext("menu", "Lookup MAC Manufacturer")}
        </.link>
      </:section>

      <:copyright title="Copyright">
        <span>{gettext("Copyright© Jonathan Gao. All rights reserved")}</span>
      </:copyright>
    </.dm_page_footer>
  </body>
</html>
