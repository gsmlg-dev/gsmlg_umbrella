<.wc_simple_appbar
  home={~p"/"}
  title={assigns[:title]}
  menus={[
    %{label: "Blog", to: ~p"/blogs"},
    %{label: "Toolbox", to: ~p"/tools"}
  ]}
>
  <:logo>
    <.link href={~p"/"}>
      <.app_logo />
    </.link>
  </:logo>
  <:user_profile>
    <.link class="flex flex-row gap-2" href="https://github.com/gsmlg-dev" target="_blank">
      <.wc_mdi name="github" class="h-10 w-10" />
    </.link>
  </:user_profile>
</.wc_simple_appbar>
<main class="px-4 sm:px-6 lg:px-8 min-h-[calc(100vh-120px)]">
  <div class="mx-auto max-w-screen-2xl">
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.flash kind={:error} title="Error!" flash={@flash} />
    <.flash
      id="disconnected"
      kind={:error}
      title="We can't find the internet"
      close={false}
      autoshow={false}
      phx-disconnected={show("#disconnected")}
      phx-connected={hide("#disconnected")}
    >
      Attempting to reconnect <.wc_bsi name="arrow-repeat" class="ml-1 w-3 h-3 inline animate-spin" />
    </.flash>
    <%= @inner_content %>
  </div>
</main>
