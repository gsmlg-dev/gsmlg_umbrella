<.dm_page_header
  class={[
    "bg-gradient-to-br from-teal-500 to-indigo-500",
    "text-slate-200 h-fit py-6"
  ]}
  nav_class={["bg-gradient-to-br from-teal-500 to-indigo-500 text-slate-200 shadow z-20"]}
>
  <:menu to={~p"/"}>
    {dgettext("menu", "Home")}
  </:menu>
  <:menu to={~p"/blogs"}>
    {dgettext("menu", "Blog")}
  </:menu>
  <:menu to={~p"/toolbox"}>
    {dgettext("menu", "Toolbox")}
  </:menu>
  <:user_profile>
    <.link class="flex flex-row gap-2" href="https://github.com/gsmlg-dev" target="_blank">
      <.dm_mdi name="github" class="h-10 w-10" />
    </.link>
  </:user_profile>
  <%= if assigns[:header_slot] do %>
    {@header_slot}
  <% end %>
</.dm_page_header>
<main class="flex flex-col items-center min-h-[calc(100vh-400px)]">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
