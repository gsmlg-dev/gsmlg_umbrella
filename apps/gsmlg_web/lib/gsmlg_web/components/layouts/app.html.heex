<.wc_simple_appbar
  title={assigns[:title]}
  menus={[
    %{label: "Blog", to: ~p"/blogs"},
    %{label: "Toolbox", to: ~p"/tools"}
  ]}
>
  <:logo>
    <.link href={~p"/"}>
      <.app_logo />
    </.link>
  </:logo>
  <:user_profile>
    <.link class="flex flex-row gap-2" href="https://github.com/gsmlg-dev" target="_blank">
      <.wc_mdi name="github" class="h-10 w-10" />
    </.link>
  </:user_profile>
</.wc_simple_appbar>
<section class="flex flex-col justify-evenly items-center w-screen h-64 bg-sky-500 text-purple-300">
  <h2 class="text-2xl lg:text-4xl xl:text-6xl flex justify-center">
    亦余心之所<span class="animate-bounce">善</span>兮
  </h2>
  <h2 class="text-2xl lg:text-4xl xl:text-6xl flex justify-center">
    虽九<span class="animate-bounce">死</span>其犹未悔
  </h2>
</section>
<main class="px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-screen-2xl">
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.flash kind={:error} title="Error!" flash={@flash} />
    <.flash
      id="disconnected"
      kind={:error}
      title="We can't find the internet"
      close={false}
      autoshow={false}
      phx-disconnected={show("#disconnected")}
      phx-connected={hide("#disconnected")}
    >
      Attempting to reconnect
      <.wc_bsi name="arrow-repeat" class="ml-1 w-3 h-3 inline animate-spin" />
    </.flash>
    <%= @inner_content %>
  </div>
</main>
