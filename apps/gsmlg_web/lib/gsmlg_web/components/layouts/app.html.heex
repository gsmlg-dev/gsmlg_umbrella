<.wc_simple_appbar
  home={~p"/"}
  title="GSMLG Web"
  menus={[
    %{ label: "Blog", to: ~p"/blogs" },
    %{ label: "Toolbox", to: ~p"/tools" },
  ]}
>
<:logo><.app_logo /></:logo>
<:user_profile>
  <.link href={"https://github.com/gsmlg-dev"} target="_blank">Github</.link>
</:user_profile>
</.wc_simple_appbar>
<section class="flex flex-col justify-evenly items-center w-screen h-64 bg-sky-500 text-purple-300">
  <h2 class="text-2xl lg:text-4xl xl:text-6xl flex justify-center">长<span class="animate-bounce">风</span>破浪会有时</h2>
  <h2 class="text-2xl lg:text-4xl xl:text-6xl flex justify-center">直挂云帆<span class="animate-bounce">济</span>沧海</h2>
</section>
<main class="px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-screen-2xl">
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.flash kind={:error} title="Error!" flash={@flash} />
    <.flash
      id="disconnected"
      kind={:error}
      title="We can't find the internet"
      close={false}
      autoshow={false}
      phx-disconnected={show("#disconnected")}
      phx-connected={hide("#disconnected")}
    >
      Attempting to reconnect <Heroicons.arrow_path class="ml-1 w-3 h-3 inline animate-spin" />
    </.flash>
    <%= @inner_content %>
  </div>
</main>
