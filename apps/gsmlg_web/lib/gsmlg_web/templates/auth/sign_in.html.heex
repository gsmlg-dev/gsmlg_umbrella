<div class="sign-up-page">
  <%= form_for @changeset, Routes.auth_path(@conn, :sign_in), [class: "sign-up-form"], fn f -> %>
    <ui5-title class="sign-up-title">
      Sign In
    </ui5-title>

    <span><%= wc_link "Sign UP", to: Routes.auth_path(@conn, :new) %></span>

    <div class="form-group">
      <%= wc_text_input f, :username, icon: "user" %>
    </div>

    <div class="form-group">
      <%= wc_password_input f, :password, icon: "key" %>
    </div>

    <div class="form-group">
      <%= wc_submit "Save" %>
    </div>
  <% end %>
</div>
