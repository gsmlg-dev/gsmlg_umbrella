<div class="login-page">
  <%= form_for @changeset, Routes.auth_path(@conn, :sign_up), [class: "login-form"], fn f -> %>
    <ui5-title class="login-title">
      SIGN UP
    </ui5-title>

    <span><%= bx_link "Sign IN", to: Routes.auth_path(@conn, :index) %></span>

    <div class="form-group">
      <%= bx_label f, :email %>
      <%= bx_text_input f, :email %>
      <%= error_tag f, :email %>
    </div>

    <div class="form-group">
      <%= bx_label f, :username %>
      <%= bx_text_input f, :username %>
      <%= error_tag f, :username %>
    </div>

    <div class="form-group">
      <%= bx_label f, :password %>
      <%= bx_password_input f, :password %>
      <%= error_tag f, :password %>
    </div>

    <div class="form-group">
      <%= bx_submit "Save" %>
    </div>
  <% end %>
</div>
