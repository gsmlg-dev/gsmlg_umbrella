<div class="login-page">
  <%= form_for @changeset, Routes.auth_path(@conn, :sign_up), [class: "login-form"], fn f -> %>
    <ui5-title class="login-title">
      SIGN UP
    </ui5-title>

    <span><%= wc_link "Sign IN", to: Routes.auth_path(@conn, :index) %></span>

    <div class="form-group">
      <%= wc_text_input f, :email %>
    </div>

    <div class="form-group">
      <%= wc_text_input f, :username %>
    </div>

    <div class="form-group">
      <%= wc_password_input f, :password %>
    </div>

    <div class="form-group">
      <%= wc_submit "Save" %>
    </div>
  <% end %>
</div>
