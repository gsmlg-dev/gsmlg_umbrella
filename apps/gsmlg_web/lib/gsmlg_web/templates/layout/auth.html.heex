<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <%= csrf_meta_tag() %>
    <%= live_title_tag assigns[:page_title] || "GSMLG", suffix: " · BITW" %>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script async phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
  </head>
  <body>
    <mwc-top-app-bar-fixed>
      <mwc-icon-button icon="menu" slot="navigationIcon"></mwc-icon-button>
      <div slot="title">GSMLG</div>
      <mwc-icon-button icon="file_download" slot="actionItems"></mwc-icon-button>
      <mwc-icon-button icon="print" slot="actionItems"></mwc-icon-button>
      <mwc-icon-button icon="favorite" slot="actionItems"></mwc-icon-button>
    </mwc-top-app-bar-fixed>

    <div class="main auth-main">
    <%= @inner_content %>
    </div>
  </body>
</html>
