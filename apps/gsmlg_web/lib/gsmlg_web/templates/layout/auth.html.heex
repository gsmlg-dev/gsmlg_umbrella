<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <%= csrf_meta_tag() %>
    <%= live_title_tag assigns[:page_title] || "GSMLG", suffix: " · BITW" %>
    <link phx-track-static rel="stylesheet" href={Routes.static_path(@conn, "/assets/app.css")}/>
    <script phx-track-static type="text/javascript" src={Routes.static_path(@conn, "/assets/app.js")}></script>
  </head>
  <body>
    <ui5-shellbar
      primary-title="GSMLG"
      secondary-title="Best in the World"
      show-co-pilot
    >
      <ui5-button icon="menu" slot="startButton" id="startButton"></ui5-button>
    </ui5-shellbar>

    <div class="main auth-main">
    <%= @inner_content %>
    </div>
  </body>
</html>
