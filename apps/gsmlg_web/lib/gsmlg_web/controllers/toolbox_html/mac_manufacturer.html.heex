<div class="flex flex-col container px-8">
  <div class="flex justify-center items-center">
    <.form
      :let={f}
      id="mac-manufacturer-form"
      method="POST"
      class="flex flex-col justify-center items-center gap-4 w-84"
    >
      <input name="_csrf_token" type="hidden" value={get_csrf_token()} />
      <.dm_input field={f[:mac]} label="MAC" />
      <div class="flex justify-center items-center w-full">
        <.button class="w-full" phx-disable-with="Searching...">Lookup</.button>
      </div>
    </.form>
  </div>

  <%= unless is_nil(assigns[:short]) do %>
    <div class="mt-4 flex flex-col justify-center items-center">
      <div class="w-96 flex flex-row justify-start items-start">
        <div class="w-32 text-right pr-2 after:content-[':']">Short</div>
        <div class=""><%= @short %></div>
      </div>
      <%= unless is_nil(assigns[:full]) do %>
        <div class="w-96 flex flex-row justify-start items-start">
          <div class="w-32 text-right pr-2 after:content-[':']">Full Information</div>
          <div class=""><%= @full %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
