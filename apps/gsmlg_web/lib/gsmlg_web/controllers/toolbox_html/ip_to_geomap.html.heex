<div class="flex flex-col container px-4 gap-4">
  <div class="flex justify-center items-center">
    <div class="w-full aspect-w-16 aspect-h-8 flex flex-row justify-center items-center">
      <script type="module">
        import 'https://esm-run.gsmlg.dev/@gsmlg/lit/d3-geo';
        document.querySelectorAll("d3-world-map").forEach((el) => {
          el.classList.remove('skeleton');
        });
      </script>
      <d3-world-map id="ip-geo-map" class="w-full h-screen aspect-w-16 aspect-h-8 skeleton" />
    </div>
  </div>

  <div class="flex flex-col justify-center items-center gap-4">
    <div class="w-full aspect-w-3 aspect-h-1 flex flex-row justify-center items-center">
      <textarea id="ip-data" class="textarea textarea-bordered" id="code" rows="10" cols="50"></textarea>
    </div>
    <div class="w-full flex flex-row justify-center items-center">
      <button
        id="submit-ip"
        class="btn btn-primary"
      >
        Send IP to Geo Map
      </button>
    </div>
  </div>

  <script type="module">
    import { ajax } from 'https://esm-run.gsmlg.dev/rxjs/ajax';
    import { fromEvent, take, from, of, map, concatMap, scan } from 'https://esm-run.gsmlg.dev/rxjs';
    const csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");
    const btn = document.getElementById('submit-ip');
    const ipGeoMap = document.getElementById('ip-geo-map');

    const submit$ = fromEvent(btn, 'click');
    const sendResult = async () => {
      btn.disabled = true;
      const code = document.getElementById('ip-data').value;
      const ipList = code.split(/\s+/).filter((line) => !/^\s*$/.test(line));
      from(ipList).pipe(concatMap((ip) => {
        return ajax({
            url: '/api/toolbox/ip_to_geomap?ip='+ip,
            method: 'GET',
            headers: {
                'x-csrf-token': csrfToken,
            },
        }).pipe(
          map(userResponse => userResponse.response.data));
      })).pipe(scan((acc, ipInfo, index) => {
        if (ipInfo.latitude && ipInfo.longitude) {
          acc.push([ipInfo.longitude, ipInfo.latitude]);
        }
        if (index === ipList.length - 1) {
            submit$.pipe(take(1)).subscribe(sendResult);
            btn.disabled = false;
        }
        return acc;
      }, [])).subscribe((ipGeoList) => {
        ipGeoMap.setAttribute('points', JSON.stringify(ipGeoList));
      });
    };
    submit$.pipe(take(1)).subscribe(sendResult);
  </script>

  <div class="w-full h-16" />
</div>
