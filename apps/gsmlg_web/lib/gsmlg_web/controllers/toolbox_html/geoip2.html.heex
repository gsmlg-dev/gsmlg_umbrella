<h3 class="text-2xl text-center mt-4">GeoIP2</h3>

<div class="flex justify-center items-center">
  <.simple_form
    :let={f}
    for={@conn}
    id="ip-form"
    method={:post}
    phx-change="validate"
    phx-submit="save"
  >
    <input name="_csrf_token" type="hidden" value={get_csrf_token()} />
    <.input field={{f, :ip}} type="text" label="IP" />
    <.input field={{f, :lang}} type="select" label="Language" options={@langs} />
    <:actions>
      <.button class="w-full" phx-disable-with="Searching...">Lookup</.button>
    </:actions>
  </.simple_form>
</div>

<%= unless is_nil(@ipInfo) do %>
  <div class="mt-4 flex flex-col justify-center items-center">
    <div class="w-96 flex flex-row justify-start items-start">
      <div class="w-24 text-right pr-2 after:content-[':']">大洲</div>
      <div class=""><%= @ipInfo.continent %></div>
    </div>
    <div class="w-96 flex flex-row justify-start items-start">
      <div class="w-24 text-right pr-2 after:content-[':']">国家</div>
      <div class=""><%= @ipInfo.country %></div>
    </div>
    <div class="w-96 flex flex-row justify-start items-start">
      <div class="w-24 text-right pr-2 after:content-[':']">城市</div>
      <div class=""><%= @ipInfo.city %></div>
    </div>
    <div class="w-96 flex flex-row justify-start items-start">
      <div class="w-24 text-right pr-2 after:content-[':']">经纬度</div>
      <div class="">
        latitude: <%= @ipInfo.latitude %> longitude: <%= @ipInfo.longitude %>
      </div>
    </div>
    <div class="2xl:w-2/3 xl:w-3/4 lg:w-4/5 w-full h-[420px] 2xl:h-[600px] xl:h-[500px] lg:h-[480px] flex flex-row justify-center items-center">
      <d3-world-map
        class="w-full"
        points={Jason.encode!([[@ipInfo.longitude, @ipInfo.latitude]])}
        center-longitude={@ipInfo.longitude}
      >
      </d3-world-map>
    </div>
  </div>
<% end %>
