<div class="container px-8 my-24 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/geoip2"}>GeoIP2 Database</.link>
  </div>
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/whois"}>Whois Domain / IP / ASN</.link>
  </div>
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/mac_manufacturer"}>Lookup MAC Manufacturer</.link>
  </div>
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/svg2react"}>SVG to React Component</.link>
  </div>
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/svg_autocrop"}>SVG Autocrop, Optimize SVG</.link>
  </div>
  <div class="min-w-48 h-16 px-4 flex justify-center items-center shadow dark:shadow-slate-400">
    <.link href={~p"/tools/ip_to_geomap"}>IP to Geo Map</.link>
  </div>
</div>
