<div class="flex flex-col container px-8">
  <div class="flex justify-center items-center">
    <.dm_form
      :let={f}
      for={to_form(%{"look_for" => @look_for})}
      id="ip-form"
      method="POST"
      class="flex flex-col justify-center items-center gap-4 w-84"
    >
      <input name="_csrf_token" type="hidden" value={get_csrf_token()} />
      <.dm_input field={f[:look_for]} label="Domain / IP / ASN" />
      <div class="flex justify-center items-center w-full">
        <.button class="w-full" phx-disable-with="Searching...">Lookup</.button>
      </div>
    </.dm_form>
  </div>

  <%= unless is_nil(@whois_info) do %>
    <div class="mt-4 flex flex-col justify-center items-start gap-4">
      <h3 class="text-xl py-2 text-primary">Whois Informaion</h3>
      <div :for={{server, info} <- @whois_info} :if={is_list(@whois_info)}>
        <div class="text-lg text-secondary">{server}</div>
        <div>
          <pre>{info}</pre>
        </div>
      </div>
      <%= unless is_nil(@reason) do %>
        <pre class="text-red-500"><%= @reason %></pre>
      <% end %>
    </div>
  <% end %>
</div>
