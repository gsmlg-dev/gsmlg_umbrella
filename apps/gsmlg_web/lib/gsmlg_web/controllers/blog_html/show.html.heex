<div class="container flex flex-col gap-y-6 mt-6">
  <div class="flex flex-col justify-start">
    <h3 class="text-blue-500 text-4xl">
      <%= @blog.title %>
    </h3>
    <author class="text-2xl text-fuchsia-300">
      <%= @blog.author %>
    </author>
    <time class="text-xl text-pink-300"><%= @blog.date %></time>
    <remark-element>
      <%= @blog.content %>
    </remark-element>
  </div>
</div>
